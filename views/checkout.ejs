<script>
  function togglePaymentFields() {
    const method = document.querySelector('input[name="paymentMethod"]:checked').value;
    document.getElementById('bankFields').style.display = method === 'Bank Transfer' ? 'block' : 'none';
  }

  const SUBTOTAL = <%- subtotal %>;
  const STANDARD_FEE = <%- standardFee %>;
  const EXPRESS_FEE = <%- expressFee %>;
  const TAX_RATE = 0.05;

  function formatPKR(n) {
    return 'Rs. ' + Math.round(n).toLocaleString('en-PK');
  }

  function updateSummary() {
    const method = document.querySelector('input[name="deliveryMethod"]:checked').value;
    const deliveryFee = method === 'Express' ? EXPRESS_FEE : STANDARD_FEE;

    const tax = SUBTOTAL * TAX_RATE;
    const total = SUBTOTAL + tax + deliveryFee;

    document.getElementById('summaryShipping').textContent = formatPKR(deliveryFee);
    document.getElementById('summaryTax').textContent = formatPKR(tax);
    document.getElementById('summaryTotal').textContent = formatPKR(total);

    const today = new Date();
    const days = method === 'Express' ? 2 : 5;
    const estDate = new Date(today.getTime() + days * 24 * 60 * 60 * 1000);
    document.getElementById('estimatedDelivery').innerHTML =
      '<i class="fas fa-calendar-check me-1"></i> Estimated delivery by ' +
      estDate.toLocaleDateString('en-PK', { weekday: 'long', month: 'long', day: 'numeric' });
  }

  function validateCheckoutForm() {
    const form = document.getElementById('checkoutForm');
    const btn = document.getElementById('placeOrderBtn');
    btn.disabled = !form.checkValidity();
  }

  document.getElementById('checkoutForm').addEventListener('input', validateCheckoutForm);
  document.getElementById('checkoutForm').addEventListener('change', validateCheckoutForm);

  document.getElementById('checkoutForm').addEventListener('submit', function (e) {
    this.classList.add('was-validated');
    if (!this.checkValidity()) {
      e.preventDefault();
      return;
    }
    document.getElementById('placeOrderText').style.display = 'none';
    document.getElementById('placeOrderSpinner').style.display = 'inline-block';
    document.getElementById('placeOrderBtn').disabled = true;
  });

  // Init on load
  updateSummary();
  validateCheckoutForm();
</script>