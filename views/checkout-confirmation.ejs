<section class="section fade-in bg-alt checkout-page page-section-padded">
  <div class="container">

    <div class="checkout-steps mb-5 justify-content-center d-flex">
      <div class="step done"><span class="step-circle"><i class="fas fa-check"></i></span> Cart</div>
      <div class="step-line"></div>
      <div class="step done"><span class="step-circle"><i class="fas fa-check"></i></span> Checkout</div>
      <div class="step-line"></div>
      <div class="step active"><span class="step-circle">3</span> Confirmation</div>
    </div>

    <div class="text-center mb-5">
      <div class="confirm-icon"><i class="fas fa-check"></i></div>
      <h2 class="mt-3">Order <span class="blue">Confirmed!</span></h2>
      <p class="sub">Thank you, <%= order.customerName %>. Your order has been placed successfully.</p>
      <span class="secure-pill">Order #<%= order._id.toString().slice(-8).toUpperCase() %></span>
    </div>

    <div class="row g-4 justify-content-center">
      <div class="col-lg-7">
        <div class="checkout-card mb-4">
          <h5 class="checkout-card-title"><i class="fas fa-box me-2"></i>Order Items</h5>
          <div class="checkout-items">
            <% order.items.forEach(item => { %>
              <div class="checkout-item">
                <div class="checkout-item-img">
                  <% if (item.product && item.product.image) { %>
                    <img src="<%= item.product.image %>" alt="<%= item.name %>"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                  <% } %>
                  <div class="checkout-item-img-fallback" style="<%= (item.product && item.product.image) ? 'display:none;' : '' %>"><i class="fas fa-image"></i></div>
                </div>
                <div class="checkout-item-info">
                  <div class="checkout-item-name"><%= item.name %></div>
                  <div class="checkout-item-qty">Qty: <%= item.quantity %></div>
                </div>
                <div class="checkout-item-price"><%= formatPrice(item.price * item.quantity) %></div>
              </div>
            <% }) %>
          </div>

          <div class="mt-3 pt-3 order-summary-divider">
            <div class="d-flex justify-content-between mb-2 summary-row">
              <span>Subtotal</span><span class="fw-semibold"><%= formatPrice(order.subtotal) %></span>
            </div>
            <div class="d-flex justify-content-between mb-2 summary-row">
              <span>Shipping (<%= order.deliveryMethod %>)</span><span class="fw-semibold"><%= order.deliveryFee === 0 ? 'FREE' : formatPrice(order.deliveryFee) %></span>
            </div>
            <div class="d-flex justify-content-between mb-3 summary-row">
              <span>Tax</span><span class="fw-semibold"><%= formatPrice(order.tax) %></span>
            </div>
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-bold fs-5">Grand Total</span>
              <span class="fw-bold fs-4 total-amount"><%= formatPrice(order.totalAmount) %></span>
            </div>
          </div>
        </div>

        <div class="row g-4">
          <div class="col-md-6">
            <div class="checkout-card h-100">
              <h5 class="checkout-card-title"><i class="fas fa-map-marker-alt me-2"></i>Delivery Address</h5>
              <p class="mb-1" style="color:#0B1F3A;"><%= order.customerName %></p>
              <p class="mb-1" style="color:#5C6F82;">
                <%= [order.shippingAddress.houseNo, order.shippingAddress.street, order.shippingAddress.area].filter(Boolean).join(', ') %>
              </p>
              <p class="mb-1" style="color:#5C6F82;">
                <%= [order.shippingAddress.city, order.shippingAddress.province, order.shippingAddress.postalCode].filter(Boolean).join(', ') %>
              </p>
              <p class="mb-0" style="color:#5C6F82;"><i class="fas fa-phone me-1"></i> <%= order.phone %></p>
            </div>
          </div>
          <div class="col-md-6">
            <div class="checkout-card h-100">
              <h5 class="checkout-card-title"><i class="fas fa-credit-card me-2"></i>Payment</h5>
              <p class="mb-1" style="color:#0B1F3A;"><%= order.paymentMethod %></p>
              <p class="mb-1" style="color:#5C6F82;">Payment Status: <span class="status-badge"><%= order.paymentStatus %></span></p>
              <p class="mb-0" style="color:#5C6F82;">Order Status: <span class="status-badge"><%= order.status %></span></p>
              <% if (paymentInstructions) { %>
                <p class="mt-3 mb-0 small" style="color:#5C6F82;"><i class="fas fa-info-circle me-1"></i><%= paymentInstructions %></p>
              <% } %>
              <% if (order.paymentStatus === 'Paid') { %>
                <p class="mt-3 mb-0 small" style="color:#00ffc6;"><i class="fas fa-check-circle me-1"></i>Payment verified successfully.</p>
              <% } else if (order.paymentStatus === 'Failed' && order.paymentRejectionReason) { %>
                <p class="mt-3 mb-0 small" style="color:#ff6b6b;"><i class="fas fa-exclamation-triangle me-1"></i>Payment rejected: <%= order.paymentRejectionReason %></p>
              <% } %>
            </div>
          </div>
        </div>

        <% if (order.paymentMethod === 'Bank Transfer') { %>
          <div class="checkout-card mt-4">
            <h5 class="checkout-card-title"><i class="fas fa-university me-2"></i>Bank Transfer Details</h5>
            <div class="row g-3 mb-4">
              <div class="col-sm-6">
                <p class="mb-0 small" style="color:#6B7C93;">Bank Name</p>
                <p class="mb-0" style="color:#0B1F3A;"><%= bankDetails.bankName %></p>
              </div>
              <div class="col-sm-6">
                <p class="mb-0 small" style="color:#6B7C93;">Account Title</p>
                <p class="mb-0" style="color:#0B1F3A;"><%= bankDetails.accountTitle %></p>
              </div>
              <div class="col-sm-6">
                <p class="mb-0 small" style="color:#6B7C93;">Account Number</p>
                <p class="mb-0" style="color:#0B1F3A;"><%= bankDetails.accountNumber %></p>
              </div>
              <div class="col-sm-6">
                <p class="mb-0 small" style="color:#6B7C93;">IBAN</p>
                <p class="mb-0" style="color:#0B1F3A;"><%= bankDetails.iban %></p>
              </div>
              <div class="col-12">
                <p class="mb-0 small" style="color:#6B7C93;">Amount to Transfer</p>
                <p class="mb-0 fw-bold total-amount"><%= formatPrice(order.totalAmount) %></p>
              </div>
            </div>

            <hr style="border-color: rgba(0, 174, 239,0.15);">

            <h6 class="mb-2" style="color:#0B1F3A;">Submit Your Payment Details</h6>
            <p class="small mb-3" style="color:#5C6F82;">Please complete your bank transfer and submit your transaction details for verification.</p>

            <% if (order.paymentSubmittedAt) { %>
              <p class="small mb-3" style="color:#00ffc6;">
                <i class="fas fa-check-circle me-1"></i>
                Submitted on <%= new Date(order.paymentSubmittedAt).toLocaleString('en-PK') %>. You can update these details below if needed.
              </p>
            <% } %>

            <form action="/checkout/confirmation/<%= order._id %>/payment-proof" method="POST" enctype="multipart/form-data">
              <div class="row g-3 align-items-end">
                <div class="col-md-6">
                  <label class="form-label">Transaction Reference Number</label>
                  <input type="text" name="transactionReference" class="form-control chk-input" value="<%= order.transactionReference || '' %>" placeholder="e.g. your bank's transaction ID" minlength="4" maxlength="100" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Payment Receipt <span class="small" style="color:#6B7C93;">(optional, JPG/PNG/PDF, max 5MB)</span></label>
                  <input type="file" name="paymentProof" class="form-control chk-input" accept=".jpg,.jpeg,.png,.webp,.pdf">
                </div>
                <% if (order.paymentProof) { %>
                  <div class="col-12">
                    <a href="/checkout/confirmation/<%= order._id %>/receipt" target="_blank" class="small" style="color:#00AEEF;">
                      <i class="fas fa-file-alt me-1"></i>View your previously uploaded receipt
                    </a>
                  </div>
                <% } %>
                <div class="col-12">
                  <button type="submit" class="btn btn-main px-4">Submit Payment Details</button>
                </div>
              </div>
            </form>
          </div>
        <% } %>

        <div class="text-center mt-4">
          <a href="/products" class="btn btn-main py-2 px-4 me-2">Continue Shopping</a>
          <a href="/" class="btn btn-out py-2 px-4">Back to Home</a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* These rules previously only existed inside checkout.ejs's own <style>
     block. Since each EJS view renders as an independent HTML document,
     this page had no CSS for its own markup (steps, cards, item rows,
     summary rows) and was rendering unstyled. Values match checkout.ejs
     exactly — this is a bug fix, not a new design. */
  .checkout-steps {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .step {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #6B7C93;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .step.active, .step.done { color: #0B1F3A; }
  .step-circle {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(0, 174, 239,0.08);
    border: 1px solid rgba(0, 174, 239,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
  }
  .step.active .step-circle { background: linear-gradient(135deg, #E53935, #C62828); color: #ffffff; border-color: #E53935; }
  .step.done .step-circle { background: rgba(0,255,198,0.15); color: #00ffc6; border-color: rgba(0,255,198,0.3); }
  .step-line {
    width: 40px;
    height: 1px;
    background: rgba(11, 31, 58, 0.1);
  }

  .secure-pill {
    background: rgba(229, 57, 53,0.12);
    color: #E53935;
    border: 1px solid rgba(11, 31, 58, 0.1);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .checkout-card {
    background: #FFFFFF;
    border: 1px solid rgba(11, 31, 58, 0.1);
    border-radius: 16px;
    padding: 28px 24px;
  }
  .checkout-card-title {
    color: #0B1F3A;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .checkout-items { max-height: 260px; overflow-y: auto; }
  .checkout-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(0, 174, 239,0.08);
  }
  .checkout-item-img {
    width: 46px; height: 46px;
    background: rgba(0, 174, 239,0.06);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  .checkout-item-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .checkout-item-img-fallback { color: rgba(0, 174, 239,0.4); font-size: 1.1rem; }
  .checkout-item-info { flex-grow: 1; min-width: 0; }
  .checkout-item-name {
    color: #0B1F3A;
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .checkout-item-qty { color: #6B7C93; font-size: 0.75rem; }
  .checkout-item-price { color: #0B1F3A; font-size: 0.82rem; font-weight: 700; white-space: nowrap; }

  .order-summary-divider { border-bottom: 1px solid rgba(0, 174, 239,0.15); }
  .summary-row { color: #5C6F82; }
  .summary-row span:last-child { color: #0B1F3A; }
  .total-amount { color: #00AEEF; }

  .confirm-icon {
    width: 80px; height: 80px;
    background: rgba(0,255,198,0.1);
    border: 2px solid rgba(0,255,198,0.4);
    color: #00ffc6;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 2rem;
    margin: 0 auto;
  }
  .status-badge {
    background: rgba(0, 174, 239,0.1);
    color: #00AEEF;
    border: 1px solid rgba(0, 174, 239,0.25);
    padding: 3px 12px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 700;
  }

  /* Same reason as everything above: this page renders independently of
     checkout.ejs, so the payment-proof form needs its own copy of the
     input styling rather than relying on classes defined elsewhere. */
  .checkout-page .form-label {
    color: #5C6F82;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .chk-input {
    background: rgba(0, 174, 239,0.04);
    border: 1px solid rgba(0, 174, 239,0.15);
    color: #0B1F3A;
    border-radius: 10px;
    padding: 11px 14px;
  }
  .chk-input:focus {
    background: rgba(0, 174, 239,0.06);
    border-color: #00AEEF;
    box-shadow: 0 0 0 3px rgba(0, 174, 239,0.15);
    color: #0B1F3A;
  }
</style>
