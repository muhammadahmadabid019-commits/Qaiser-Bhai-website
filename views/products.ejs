

<section class="section fade-in bg-alt">
  <div class="container">
    <div class="text-center mb-5">
      <span class="tag">Shop Online</span>
      <h2>Our <span class="blue">Products</span></h2>
      <p class="sub">Find exactly what you need with our advanced filters.</p>
    </div>

    <!-- Filter Bar (above the grid, responsive) -->
    <div class="card-box p-4 mb-4" style="text-align: left; background: #FFFFFF; border: 1px solid rgba(0, 174, 239,0.15); border-radius: 16px; box-shadow: 0 10px 30px rgba(11, 31, 58, 0.1);">
      <div class="d-flex align-items-center mb-4">
        <i class="fas fa-sliders-h me-2" style="font-size: 1.2rem; color: #00AEEF;"></i>
        <h5 class="m-0" style="color: #0B1F3A; font-weight: 800; letter-spacing: 0.5px;">Refine Search</h5>
      </div>

      <form action="/products" method="GET" id="filterForm">
        <div class="row g-3 align-items-end">

          <!-- Search -->
          <div class="col-12 col-md-6 col-lg-4">
            <label class="form-label text-uppercase tracking-wide" style="color: #5C6F82; font-size: 0.8rem; font-weight: 700;"><i class="fas fa-search me-1"></i> Search Product</label>
            <input type="text" name="search" class="form-control" placeholder="e.g. Camera" value="<%= query.search || '' %>" autocomplete="off" style="background: rgba(0, 174, 239,0.04); border: 1px solid rgba(0, 174, 239,0.15); color: #0B1F3A; border-radius: 8px; padding: 10px 14px;">
          </div>

          <!-- Category -->
          <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label text-uppercase tracking-wide" style="color: #5C6F82; font-size: 0.8rem; font-weight: 700;"><i class="fas fa-tags me-1"></i> Category</label>
            <select name="category" id="categoryFilter" class="form-select" style="background-color: rgba(0, 174, 239,0.04); border: 1px solid rgba(0, 174, 239,0.15); color: #0B1F3A; border-radius: 8px; padding: 10px 14px;">
              <option value="" style="color: #000;">All Categories</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat._id %>" <%= query.category == cat._id ? 'selected' : '' %> style="color: #000;">
                  <%= cat.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <!-- Subcategory -->
          <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label text-uppercase tracking-wide" style="color: #5C6F82; font-size: 0.8rem; font-weight: 700;"><i class="fas fa-layer-group me-1"></i> Subcategory</label>
            <select name="subcategory" id="subcategoryFilter" class="form-select" style="background-color: rgba(0, 174, 239,0.04); border: 1px solid rgba(0, 174, 239,0.15); color: #0B1F3A; border-radius: 8px; padding: 10px 14px;">
              <option value="" style="color: #000;">All Subcategories</option>
            </select>
          </div>

          <!-- Price Range -->
          <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label text-uppercase tracking-wide" style="color: #5C6F82; font-size: 0.8rem; font-weight: 700;"><i class="fas fa-money-bill-wave me-1"></i> Min Price</label>
            <input type="number" name="minPrice" class="form-control" placeholder="Min" value="<%= query.minPrice || '' %>" min="0" style="background: rgba(0, 174, 239,0.04); border: 1px solid rgba(0, 174, 239,0.15); color: #0B1F3A; border-radius: 8px; padding: 10px 14px;">
          </div>
          <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label text-uppercase tracking-wide" style="color: #5C6F82; font-size: 0.8rem; font-weight: 700;"><i class="fas fa-money-bill-wave me-1"></i> Max Price</label>
            <input type="number" name="maxPrice" class="form-control" placeholder="Max" value="<%= query.maxPrice || '' %>" min="0" style="background: rgba(0, 174, 239,0.04); border: 1px solid rgba(0, 174, 239,0.15); color: #0B1F3A; border-radius: 8px; padding: 10px 14px;">
          </div>

          <!-- Actions -->
          <div class="col-12 d-flex flex-wrap justify-content-between align-items-center gap-2 mt-1">
            <span id="filterStatus" class="filter-status" aria-live="polite"></span>
            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-main fw-bold" style="border-radius: 8px; padding: 9px 22px;"><i class="fas fa-filter me-1"></i> Apply</button>
              <button type="button" id="resetFilters" class="btn btn-outline fw-semibold" style="border-radius: 8px; padding: 9px 22px;"><i class="fas fa-rotate-left me-1"></i> Reset Filters</button>
            </div>
          </div>

        </div>
      </form>
    </div>

    <!-- Product Grid (full width) — swapped in place by the live filter -->
    <div class="row">
      <div class="col-12">
        <div id="productResults" class="product-results">
          <%- include('partials/product-results', { products, totalPages, currentPage, query, currentUrl: typeof currentUrl !== 'undefined' ? currentUrl : '/products' }) %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Inline style for custom pagination to match theme -->
<style>
  /* Bootstrap's .pagination is a non-wrapping flex row by default, so on
     narrow screens the tail-end page numbers get pushed past the
     container edge and clipped. Letting items wrap keeps every page
     number on-screen without touching the pagination markup/logic. */
  .custom-pagination {
    flex-wrap: wrap;
    row-gap: 8px;
  }
  .custom-pagination .page-item {
    display: flex;
  }
  .custom-pagination .page-link {
    color: #0B1F3A;
    border-color: #dee2e6;
    margin: 0 4px;
    border-radius: 8px;
    min-width: 40px;
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .custom-pagination .page-item.active .page-link {
    background-color: #145DA0;
    border-color: #145DA0;
    color: white;
  }
  .custom-pagination .page-link:hover {
    background-color: #e9ecef;
    border-color: #dee2e6;
    color: #0B1F3A;
  }
  .custom-pagination .page-item.disabled .page-link {
    color: #6c757d;
  }

  @media (max-width: 480px) {
    .custom-pagination .page-link {
      min-width: 36px;
      min-height: 36px;
      padding: 0.35rem 0.55rem;
      margin: 2px;
      font-size: 0.85rem;
    }
  }

  /* Live-filter feedback */
  .product-results {
    position: relative;
    transition: opacity 0.15s ease;
    min-height: 120px;
  }
  .product-results.is-loading {
    opacity: 0.45;
    pointer-events: none;
  }
  .product-results.is-loading::after {
    content: "";
    position: absolute;
    top: 40px;
    left: 50%;
    width: 34px;
    height: 34px;
    margin-left: -17px;
    border: 3px solid rgba(20, 93, 160, 0.25);
    border-top-color: #145DA0;
    border-radius: 50%;
    animation: prodspin 0.7s linear infinite;
  }
  @keyframes prodspin { to { transform: rotate(360deg); } }

  .filter-status {
    color: #5C6F82;
    font-size: 0.82rem;
    font-weight: 600;
  }
</style>

<script>
  (function () {
    const allSubcategories = <%- JSON.stringify(subcategories.map(s => ({ id: s._id, name: s.name, category: s.category }))) %>;
    const initialSubcategoryId = <%- JSON.stringify(query.subcategory || '') %>;

    const form       = document.getElementById('filterForm');
    const results    = document.getElementById('productResults');
    const searchIn   = form.querySelector('input[name="search"]');
    const catSel     = document.getElementById('categoryFilter');
    const subSel     = document.getElementById('subcategoryFilter');
    const minIn      = form.querySelector('input[name="minPrice"]');
    const maxIn      = form.querySelector('input[name="maxPrice"]');
    const resetBtn   = document.getElementById('resetFilters');
    const statusEl   = document.getElementById('filterStatus');

    // ---- Subcategory options depend on the chosen category -------------
    function refreshSubcategoryFilterOptions(selectedCategoryId, keepSubId) {
      const matches = selectedCategoryId
        ? allSubcategories.filter(s => String(s.category) === String(selectedCategoryId))
        : allSubcategories;
      subSel.innerHTML = '<option value="" style="color:#000;">All Subcategories</option>' +
        matches.map(s => `<option value="${s.id}" style="color:#000;">${s.name}</option>`).join('');
      if (keepSubId) subSel.value = keepSubId;
    }
    refreshSubcategoryFilterOptions(catSel.value, initialSubcategoryId);

    // ---- Live filtering ----------------------------------------------
    let controller = null;
    let reqId = 0;

    function buildUrl() {
      const p = new URLSearchParams();
      if (searchIn.value.trim()) p.set('search', searchIn.value.trim());
      if (catSel.value)          p.set('category', catSel.value);
      if (subSel.value)          p.set('subcategory', subSel.value);
      if (minIn.value !== '')    p.set('minPrice', minIn.value);
      if (maxIn.value !== '')    p.set('maxPrice', maxIn.value);
      const qs = p.toString();
      return '/products' + (qs ? '?' + qs : '');
    }

    function bindCards(scope) {
      scope.querySelectorAll('.product-card-clickable').forEach(function (card) {
        card.addEventListener('click', function (e) {
          if (e.target.closest('form') || e.target.closest('a')) return;
          window.location = card.dataset.href;
        });
      });
    }

    function setStatus() {
      if (!statusEl) return;
      const empty = results.querySelector('.text-center.py-5');
      const n = results.querySelectorAll('.product-card').length;
      statusEl.textContent = empty ? 'No products match your filters'
                                   : (n + (n === 1 ? ' product' : ' products') + ' on this page');
    }

    async function run(targetUrl, opts) {
      opts = opts || {};
      const mine = ++reqId;
      if (controller) controller.abort();
      controller = new AbortController();

      results.classList.add('is-loading');
      try {
        const sep = targetUrl.indexOf('?') === -1 ? '?' : '&';
        const res = await fetch(targetUrl + sep + 'partial=1', {
          headers: { 'X-Requested-With': 'XMLHttpRequest' },
          signal: controller.signal
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const html = await res.text();
        if (mine !== reqId) return;            // a newer request superseded this one
        results.innerHTML = html;
        bindCards(results);
        setStatus();
        if (opts.push !== false) history.pushState({ filtered: true }, '', targetUrl);
        if (opts.scroll) {
          const top = document.querySelector('.card-box');
          if (top) window.scrollTo({ top: top.getBoundingClientRect().top + window.pageYOffset - 20, behavior: 'smooth' });
        }
      } catch (err) {
        if (err.name === 'AbortError') return;
        // Network / server hiccup — fall back to a normal navigation so the
        // user is never stuck with stale results.
        window.location = targetUrl;
        return;
      } finally {
        if (mine === reqId) results.classList.remove('is-loading');
      }
    }

    function applyFilters(opts) { run(buildUrl(), opts); }

    function debounce(fn, ms) {
      let t;
      return function () { clearTimeout(t); t = setTimeout(fn, ms); };
    }
    const debouncedApply = debounce(function () { applyFilters(); }, 350);

    searchIn.addEventListener('input', debouncedApply);
    minIn.addEventListener('input', debounce(function () { applyFilters(); }, 450));
    maxIn.addEventListener('input', debounce(function () { applyFilters(); }, 450));

    catSel.addEventListener('change', function () {
      refreshSubcategoryFilterOptions(this.value, null);
      applyFilters();
    });
    subSel.addEventListener('change', function () { applyFilters(); });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      applyFilters();
    });

    function doReset() {
      searchIn.value = '';
      catSel.value = '';
      minIn.value = '';
      maxIn.value = '';
      refreshSubcategoryFilterOptions('', null);
      applyFilters();
    }
    if (resetBtn) resetBtn.addEventListener('click', doReset);

    // Pagination + empty-state reset button live inside the swapped region.
    results.addEventListener('click', function (e) {
      const pageLink = e.target.closest('a.page-link');
      if (pageLink) {
        if (pageLink.closest('.page-item.disabled')) { e.preventDefault(); return; }
        e.preventDefault();
        run(new URL(pageLink.getAttribute('href'), window.location.href).toString(), { scroll: true });
        return;
      }
      if (e.target.closest('[data-reset-filters]')) {
        e.preventDefault();
        doReset();
      }
    });

    // Back / forward buttons — rebuild the form state from the URL, no push.
    window.addEventListener('popstate', function () {
      const q = new URLSearchParams(window.location.search);
      searchIn.value = q.get('search') || '';
      catSel.value   = q.get('category') || '';
      refreshSubcategoryFilterOptions(catSel.value, q.get('subcategory') || '');
      minIn.value    = q.get('minPrice') || '';
      maxIn.value    = q.get('maxPrice') || '';
      run(window.location.pathname + window.location.search, { push: false });
    });

    setStatus();
  })();
</script>
