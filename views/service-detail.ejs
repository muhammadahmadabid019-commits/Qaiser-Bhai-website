<section class="section fade-in bg-alt page-section-padded">
  <div class="container">

    <div class="mb-3">
      <a href="/#services" class="back-link">
        <i class="fas fa-arrow-left me-2"></i>Back to Services
      </a>
    </div>

    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb detail-breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/#services">Services</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= service.name %></li>
      </ol>
    </nav>

    <!-- Hero -->
    <div class="card-box p-4 p-md-5 mb-5">
      <div class="row g-5 align-items-center text-start">
        <div class="col-md-5">
          <div class="detail-hero-img">
            <% if (service.image) { %>
              <img src="<%= service.image %>" alt="<%= service.name %>" loading="eager"
                style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px;" />
            <% } else { %>
              <div class="d-flex align-items-center justify-content-center h-100">
                <div class="icon-circle" style="width: 90px; height: 90px; font-size: 2.2rem;">
                  <i class="fas <%= service.icon || 'fa-cogs' %>"></i>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="col-md-7">
          <span class="prod-cat"><i class="fas <%= service.icon || 'fa-cogs' %> me-2"></i>Service</span>
          <h1 style="color: #0B1F3A; font-size: 1.9rem; margin: 10px 0 12px;"><%= service.name %></h1>

          <p style="color: #5C6F82;"><%= service.description %></p>

          <% if (service.features && service.features.length > 0) { %>
            <ul class="detail-feature-list mb-4">
              <% service.features.forEach(feature => { %>
                <li><i class="fas fa-check"></i> <%= feature %></li>
              <% }) %>
            </ul>
          <% } %>

          <div class="d-flex flex-wrap gap-3 mt-4">
            <% if (whatsappBookingEnabled) { %>
              <a href="https://wa.me/<%= whatsappNumber %>?text=<%= encodeURIComponent('Hello, I would like to book the "' + service.name + '" service. Please share the details.') %>"
                target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp"
                style="padding: 12px 26px; font-size: 0.95rem;">
                <i class="fab fa-whatsapp"></i> Book via WhatsApp
              </a>
            <% } else { %>
              <a href="/contact" class="btn btn-main" style="padding: 12px 26px; font-size: 0.95rem;">
                <i class="fas fa-paper-plane"></i> Request a Quote
              </a>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Payment details (only when Bank Transfer is enabled in admin) -->
    <% if (bankTransfer && bankTransfer.enabled) { %>
      <div class="card-box p-4 p-md-5 mb-5 text-start">
        <h4 style="color: #0B1F3A; margin-bottom: 8px;"><i class="fas fa-building-columns me-2" style="color: var(--blue);"></i>Pay via Bank Transfer</h4>
        <p style="color: #5C6F82; font-size: 0.92rem;"><%= bankTransfer.instructions %></p>
        <div class="table-responsive mt-3">
          <table class="spec-table">
            <tbody>
              <tr><td class="spec-label">Bank Name</td><td><%= bankTransfer.config.bankName %></td></tr>
              <tr><td class="spec-label">Account Title</td><td><%= bankTransfer.config.accountTitle %></td></tr>
              <tr><td class="spec-label">Account Number</td><td><%= bankTransfer.config.accountNumber %></td></tr>
              <tr><td class="spec-label">IBAN</td><td><%= bankTransfer.config.iban %></td></tr>
              <% if (bankTransfer.config.branch) { %>
                <tr><td class="spec-label">Branch</td><td><%= bankTransfer.config.branch %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <p class="mt-3 mb-0" style="color: #5C6F82; font-size: 0.85rem;">
          <i class="fas fa-circle-info me-1"></i>
          After transferring, contact us
          <% if (whatsappBookingEnabled) { %>on WhatsApp<% } else { %>via the quote form<% } %>
          with your receipt to confirm your booking.
        </p>
      </div>
    <% } %>

  </div>
</section>
