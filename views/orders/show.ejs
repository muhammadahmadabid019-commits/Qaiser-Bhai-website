<section class="section fade-in bg-alt orders-page page-section-padded">
  <div class="container">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
      <div>
        <a href="/orders" class="back-link"><i class="fas fa-arrow-left me-2"></i>Back to My Orders</a>
        <h2 class="mt-2 mb-0">Order #<%= order._id.toString().slice(-8).toUpperCase() %></h2>
      </div>
      <div>
        <% if (order.status === 'Delivered') { %>
          <span class="status-badge status-badge-success fs-6">Delivered</span>
        <% } else if (order.status === 'Cancelled') { %>
          <span class="status-badge status-badge-danger fs-6">Cancelled</span>
        <% } else if (order.status === 'Processing' || order.status === 'Shipped') { %>
          <span class="status-badge status-badge-info fs-6"><%= order.status %></span>
        <% } else { %>
          <span class="status-badge fs-6"><%= order.status %></span>
        <% } %>
      </div>
    </div>

    <div class="row g-4">

      <div class="col-lg-8">

        <!-- Order Timeline -->
        <div class="order-card mb-4">
          <h5 class="order-card-title"><i class="fas fa-route me-2"></i>Order Timeline</h5>
          <div class="order-timeline">
            <% timeline.forEach(step => { %>
              <div class="order-timeline-step <%= step.state %>">
                <span class="order-timeline-marker">
                  <% if (step.state === 'completed') { %><i class="fas fa-check"></i>
                  <% } else if (step.state === 'failed') { %><i class="fas fa-times"></i>
                  <% } else if (step.state === 'current') { %><i class="fas fa-circle" style="font-size:0.5rem;"></i>
                  <% } %>
                </span>
                <div class="order-timeline-title">
                  <%= step.label %>
                  <% if (step.sublabel) { %><span class="order-timeline-sublabel"><%= step.sublabel %></span><% } %>
                </div>
                <% if (step.timestamp) { %>
                  <div class="order-timeline-time"><%= new Date(step.timestamp).toLocaleString('en-PK') %></div>
                <% } else if (step.state === 'current') { %>
                  <div class="order-timeline-time">In progress</div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Customer Information -->
        <div class="row g-4 mb-4">
          <div class="col-md-6">
            <div class="order-card h-100">
              <h5 class="order-card-title"><i class="fas fa-user me-2"></i>Customer Information</h5>
              <p class="mb-1" style="color:#0B1F3A;"><%= order.customerName %></p>
              <p class="mb-1" style="color:#5C6F82;"><%= order.email ? order.email : '—' %></p>
              <p class="mb-0" style="color:#5C6F82;"><i class="fas fa-phone me-1"></i> <%= order.phone %></p>
            </div>
          </div>
          <div class="col-md-6">
            <div class="order-card h-100">
              <h5 class="order-card-title"><i class="fas fa-map-marker-alt me-2"></i>Shipping Address</h5>
              <p class="mb-1" style="color:#5C6F82;">
                <%= [order.shippingAddress.houseNo, order.shippingAddress.street, order.shippingAddress.area].filter(Boolean).join(', ') %>
              </p>
              <p class="mb-0" style="color:#5C6F82;">
                <%= [order.shippingAddress.city, order.shippingAddress.province, order.shippingAddress.postalCode].filter(Boolean).join(', ') %>
              </p>
            </div>
          </div>
        </div>

        <!-- Ordered Products -->
        <div class="order-card mb-4">
          <h5 class="order-card-title"><i class="fas fa-box me-2"></i>Ordered Products</h5>
          <div class="order-items">
            <% order.items.forEach(item => { %>
              <div class="order-item">
                <div class="order-item-img">
                  <% if (item.product && item.product.image) { %>
                    <img src="<%= item.product.image %>" alt="<%= item.name %>"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                  <% } %>
                  <div class="order-item-img-fallback" style="<%= (item.product && item.product.image) ? 'display:none;' : '' %>"><i class="fas fa-image"></i></div>
                </div>
                <div class="order-item-info">
                  <div class="order-item-name"><%= item.name %></div>
                  <div class="order-item-meta">Qty: <%= item.quantity %> &times; <%= formatPrice(item.price) %></div>
                </div>
                <div class="order-item-price"><%= formatPrice(item.price * item.quantity) %></div>
              </div>
            <% }) %>
          </div>

          <div class="order-summary-divider mt-3 pt-3">
            <div class="d-flex justify-content-between mb-2 summary-row">
              <span>Subtotal</span><span class="fw-semibold"><%= formatPrice(order.subtotal) %></span>
            </div>
            <div class="d-flex justify-content-between mb-2 summary-row">
              <span>Shipping</span><span class="fw-semibold"><%= order.deliveryFee === 0 ? 'FREE' : formatPrice(order.deliveryFee) %></span>
            </div>
            <div class="d-flex justify-content-between mb-3 summary-row">
              <span>Tax</span><span class="fw-semibold"><%= formatPrice(order.tax) %></span>
            </div>
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-bold fs-5">Grand Total</span>
              <span class="fw-bold fs-4 total-amount"><%= formatPrice(order.totalAmount) %></span>
            </div>
          </div>
        </div>

      </div>

      <div class="col-lg-4">
        <!-- Payment & Order Info -->
        <div class="order-card mb-4">
          <h5 class="order-card-title"><i class="fas fa-credit-card me-2"></i>Payment Information</h5>
          <p class="mb-1" style="color:#5C6F82;">Method</p>
          <p class="mb-3 fw-semibold" style="color:#0B1F3A;"><%= order.paymentMethod %></p>

          <p class="mb-1" style="color:#5C6F82;">Payment Status</p>
          <p class="mb-3">
            <% if (order.paymentStatus === 'Paid') { %>
              <span class="status-badge status-badge-success"><%= order.paymentStatus %></span>
            <% } else if (order.paymentStatus === 'Pending Verification') { %>
              <span class="status-badge status-badge-warning"><%= order.paymentStatus %></span>
            <% } else if (order.paymentStatus === 'Failed') { %>
              <span class="status-badge status-badge-danger"><%= order.paymentStatus %></span>
            <% } else { %>
              <span class="status-badge"><%= order.paymentStatus %></span>
            <% } %>
          </p>

          <% if (order.transactionReference) { %>
            <p class="mb-1" style="color:#5C6F82;">Transaction Reference</p>
            <p class="mb-0 fw-semibold" style="color:#0B1F3A;"><%= order.transactionReference %></p>
          <% } %>

          <% if (order.paymentStatus === 'Paid') { %>
            <p class="mt-3 mb-0 small" style="color:#00ffc6;"><i class="fas fa-check-circle me-1"></i>Payment verified successfully.</p>
          <% } else if (order.paymentStatus === 'Failed' && order.paymentRejectionReason) { %>
            <p class="mt-3 mb-0 small" style="color:#ff6b6b;"><i class="fas fa-exclamation-triangle me-1"></i>Payment rejected: <%= order.paymentRejectionReason %></p>
          <% } %>
        </div>

        <div class="order-card">
          <h5 class="order-card-title"><i class="fas fa-info-circle me-2"></i>Order Information</h5>
          <p class="mb-1" style="color:#5C6F82;">Order Date</p>
          <p class="mb-3 fw-semibold" style="color:#0B1F3A;"><%= order.createdAt.toLocaleString('en-PK') %></p>

          <p class="mb-1" style="color:#5C6F82;">Current Status</p>
          <p class="mb-0">
            <% if (order.status === 'Delivered') { %>
              <span class="status-badge status-badge-success"><%= order.status %></span>
            <% } else if (order.status === 'Cancelled') { %>
              <span class="status-badge status-badge-danger"><%= order.status %></span>
            <% } else if (order.status === 'Processing' || order.status === 'Shipped') { %>
              <span class="status-badge status-badge-info"><%= order.status %></span>
            <% } else { %>
              <span class="status-badge"><%= order.status %></span>
            <% } %>
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .back-link { color: #5C6F82; font-weight: 600; font-size: 0.9rem; }
  .back-link:hover { color: #00AEEF; }

  .order-card {
    background: #FFFFFF;
    border: 1px solid rgba(0, 174, 239,0.15);
    border-radius: 16px;
    padding: 28px 24px;
  }
  .order-card-title { color: #0B1F3A; font-weight: 700; margin-bottom: 20px; }

  .status-badge {
    display: inline-block;
    background: rgba(122,146,176,0.12);
    color: #5C6F82;
    border: 1px solid rgba(122,146,176,0.25);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .status-badge-success { background: rgba(0,255,198,0.1); color: #00ffc6; border-color: rgba(0,255,198,0.3); }
  .status-badge-warning { background: rgba(255,193,7,0.12); color: #ffc107; border-color: rgba(255,193,7,0.3); }
  .status-badge-danger { background: rgba(255,107,107,0.12); color: #ff6b6b; border-color: rgba(255,107,107,0.3); }
  .status-badge-info { background: rgba(0, 174, 239,0.12); color: #00AEEF; border-color: rgba(0, 174, 239,0.3); }

  /* Order Timeline */
  .order-timeline { position: relative; padding-left: 34px; }
  .order-timeline-step { position: relative; padding-bottom: 26px; }
  .order-timeline-step:last-child { padding-bottom: 0; }
  .order-timeline-step::after {
    content: '';
    position: absolute;
    left: -25px;
    top: 22px;
    bottom: -4px;
    width: 2px;
    background: rgba(0, 174, 239,0.15);
  }
  .order-timeline-step:last-child::after { display: none; }
  .order-timeline-marker {
    position: absolute;
    left: -34px;
    top: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    border: 2px solid rgba(0, 174, 239,0.25);
    background: #0B1F3A;
    color: #6B7C93;
  }
  .order-timeline-step.completed .order-timeline-marker { background: #00ffc6; border-color: #00ffc6; color: #051221; }
  .order-timeline-step.current .order-timeline-marker { background: #00AEEF; border-color: #00AEEF; color: #051221; }
  .order-timeline-step.failed .order-timeline-marker { background: #ff6b6b; border-color: #ff6b6b; color: #051221; }
  .order-timeline-step.skipped .order-timeline-marker,
  .order-timeline-step.inactive .order-timeline-marker { opacity: 0.4; }

  .order-timeline-title { color: #0B1F3A; font-weight: 700; font-size: 0.92rem; }
  .order-timeline-step.inactive .order-timeline-title,
  .order-timeline-step.skipped .order-timeline-title { color: #6B7C93; font-weight: 600; }
  .order-timeline-sublabel {
    margin-left: 8px;
    font-size: 0.7rem;
    font-weight: 600;
    color: #6B7C93;
  }
  .order-timeline-time { color: #6B7C93; font-size: 0.78rem; margin-top: 2px; }

  /* Ordered Products */
  .order-items { max-height: 340px; overflow-y: auto; }
  .order-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(0, 174, 239,0.08);
  }
  .order-item:last-child { border-bottom: none; }
  .order-item-img {
    width: 52px; height: 52px;
    background: rgba(0, 174, 239,0.06);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  .order-item-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .order-item-img-fallback { color: rgba(0, 174, 239,0.4); font-size: 1.1rem; }
  .order-item-info { flex-grow: 1; min-width: 0; }
  .order-item-name {
    color: #0B1F3A;
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .order-item-meta { color: #6B7C93; font-size: 0.76rem; }
  .order-item-price { color: #0B1F3A; font-size: 0.88rem; font-weight: 700; white-space: nowrap; }

  .order-summary-divider { border-top: 1px solid rgba(0, 174, 239,0.15); }
  .summary-row { color: #5C6F82; }
  .summary-row span:last-child { color: #0B1F3A; }
  .total-amount { color: #00AEEF; }

  @media (max-width: 767px) {
    .order-card { padding: 22px 18px; }
  }
</style>
