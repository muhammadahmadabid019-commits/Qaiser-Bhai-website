<section class="section bg-alt fade-in page-section-padded">
  <div class="container">
    <div class="text-center mb-5">
      <span class="tag">Get In Touch</span>
      <h2>Get a <span class="blue">Free Quote</span></h2>
      <span class="section-heading-accent"></span>
      <p class="sub mt-3">Visit our office, call us, or send us a quote request and we'll get back to you within 24 hours.</p>
    </div>

    <div class="row g-4 mb-5 align-items-center">
      <div class="col-lg-5">
        <div class="office-img-wrap">
          <img src="/images/office.jpg" alt="unieQ Solutions Office" class="img-fluid" />
        </div>
      </div>

      <div class="col-lg-7">
        <div class="info-box ps-lg-3">
          <div class="info-item">
            <i class="fas fa-map-marker-alt"></i>
            <div>
              <strong>Visit Us</strong>
              <p>Office no 16/MZ-2 Al-Hafeez Shopping Mall, Gulberg3, Lahore</p>
            </div>
          </div>

          <div class="info-item">
            <i class="fas fa-phone"></i>
            <div>
              <strong>Call Us</strong>
              <p>+92-301-899-9603</p>
            </div>
          </div>

          <div class="info-item">
            <i class="fas fa-envelope"></i>
            <div>
              <strong>Email Us</strong>
              <p>theunieqsol@gmail.com / info@unieqsol.com</p>
            </div>
          </div>

          <div class="info-item">
            <i class="fas fa-clock"></i>
            <div>
              <strong>Working Hours</strong>
              <p>Mon – Sat: 9 AM – 6 PM</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-9">
        <form id="quoteForm" class="form-box">
          <div class="text-center mb-4">
            <h4 class="fw-bold" style="color: #0B1F3A;"><i class="fas fa-paper-plane text-danger me-2"></i>Get a Free Quote</h4>
            <p style="color: #5C6F82; font-size: 0.9rem; margin-bottom: 0;">Fill the form below and our team will get back to you within 24 hours.</p>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label>Full Name *</label>
              <input type="text" id="name" class="form-control" placeholder="Ahmad Ali" minlength="3" maxlength="100" required />
            </div>
            <div class="col-md-6">
              <label>Phone Number *</label>
              <input type="tel" id="phone" class="form-control" placeholder="03XXXXXXXXX" pattern="(\+92|0)3[0-9]{9}" title="Please enter a valid Pakistani mobile number." required />
              <small class="text-muted">Format: 03XXXXXXXXX or +923XXXXXXXXX</small>
            </div>
            <div class="col-md-6">
              <label>Email Address *</label>
              <input type="email" id="email" class="form-control" placeholder="you@example.com" required />
            </div>
            <div class="col-md-6">
              <label>Service Type *</label>
              <select id="service" class="form-control" required>
                <option value="">-- Select Service --</option>
                <% services.forEach(svc => { %>
                  <option><%= svc.name %></option>
                <% }) %>
                <option>Product Purchase</option>
              </select>
            </div>
            <div class="col-12">
              <label>Message *</label>
              <textarea id="message" class="form-control" rows="4" placeholder="Describe your requirements (at least 20 characters)..." minlength="20" maxlength="1000" required></textarea>
            </div>
            <div class="col-12">
              <button type="submit" id="submitBtn" class="btn btn-main w-100">
                <i class="fas fa-paper-plane"></i> Send Quote Request
              </button>
            </div>
            <div class="col-12">
              <div id="successMsg" class="success-box" style="display:none;"></div>
              <div id="errorMsg" class="error-box" style="display:none;"></div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
  $(document).ready(function () {
    // Guards against a double-click firing two overlapping submissions in
    // the brief moment before the button's disabled state visually takes
    // effect.
    let quoteSubmitting = false;

    $('#quoteForm').on('submit', function (e) {
      e.preventDefault();
      if (quoteSubmitting) return;

      const form = this;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      quoteSubmitting = true;
      const $submitBtn = $('#submitBtn');
      const originalBtnHtml = $submitBtn.html();
      $submitBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Sending...');

      $('#successMsg').hide();
      $('#errorMsg').hide();

      const formData = {
        name: $('#name').val(),
        phone: $('#phone').val(),
        email: $('#email').val(),
        service: $('#service').val(),
        message: $('#message').val()
      };

      $.ajax({
        url: '/quote',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(formData),
        success: function (response) {
          quoteSubmitting = false;
          $submitBtn.prop('disabled', false).html(originalBtnHtml);
          const msg = (response && response.message) ? response.message : 'Request sent! We\'ll contact you within 24 hours.';
          $('#successMsg').html(`<i class="fas fa-check-circle me-2"></i>${msg}`).fadeIn();
          $('#quoteForm')[0].reset();
        },
        error: function (xhr) {
          quoteSubmitting = false;
          $submitBtn.prop('disabled', false).html(originalBtnHtml);
          const responseJson = xhr.responseJSON;
          const errMsg = responseJson && responseJson.message ? responseJson.message : 'Something went wrong. Please try again.';
          $('#errorMsg').html(`<i class="fas fa-exclamation-triangle me-2"></i>${errMsg}`).fadeIn();
        }
      });
    });
  });
</script>
