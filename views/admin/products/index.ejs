<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 style="font-weight: 700; color: #082044;">Manage Products</h2>
  <a href="/admin/products/new" class="btn btn-admin-primary">
    <i class="fas fa-plus"></i> Add New Product
  </a>
</div>

<!-- Search Bar -->
<div class="card-box mb-4">
  <form action="/admin/products" method="GET" class="d-flex gap-2">
    <input type="text" name="search" class="form-control" placeholder="Search by product name or brand..."
      value="<%= typeof search !== 'undefined' ? search : '' %>">
    <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
    <% if (typeof search !=='undefined' && search) { %>
      <a href="/admin/products" class="btn btn-outline-secondary">Clear</a>
      <% } %>
  </form>
</div>

<div class="card-box">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th scope="col">Image</th>
          <th scope="col">Name</th>
          <th scope="col">Category</th>
          <th scope="col">Price</th>
          <th scope="col">Stock</th>
          <th scope="col" class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (products.length===0) { %>
          <tr>
            <td colspan="6" class="text-center py-4">
              <% if (typeof search !=='undefined' && search) { %>
                No products found matching your search.
                <% } else { %>
                  No products found. Start by adding one!
                  <% } %>
            </td>
          </tr>
          <% } else { %>
            <% products.forEach(product=> { %>
              <tr>
                <td>
                  <img src="<%= product.image %>" alt="<%= product.name %>"
                    style="width: 50px; height: 50px; object-fit: contain; background: #eef2f9; border-radius: 4px;">
                </td>
                <td class="fw-semibold">
                  <%= product.name %>
                </td>
                <td><span class="badge bg-secondary">
                    <%= product.category ? product.category.name : 'None' %>
                  </span></td>
                <td>
                  <% if (product.previousPrice && product.previousPrice> product.price) { %>
                    <span class="text-muted text-decoration-line-through me-1">
                      <%= formatPrice(product.previousPrice) %>
                    </span>
                    <% } %>
                      <%= formatPrice(product.price) %>
                </td>
                <td>
                  <% const stockStatus=getStockStatus(product.stock); %>
                    <% if (stockStatus==='In Stock' ) { %>
                      <span class="text-success"><i class="fas fa-check-circle"></i>
                        <%= product.stock %> in stock
                      </span>
                      <% } else if (stockStatus==='Low Stock' ) { %>
                        <span class="text-warning"><i class="fas fa-exclamation-triangle"></i> Low Stock (<%=
                            product.stock %>)</span>
                        <% } else { %>
                          <span class="text-danger"><i class="fas fa-times-circle"></i> Out of Stock</span>
                          <% } %>
                </td>
                <td class="text-end">
                  <a href="/admin/products/edit/<%= product._id %>" class="btn btn-sm btn-outline-primary me-2">
                    <i class="fas fa-edit"></i> Edit
                  </a>
                  <form action="/admin/products/delete/<%= product._id %>" method="POST" class="d-inline"
                    onsubmit="return confirm('WARNING: Are you sure you want to permanently delete this product?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                      <i class="fas fa-trash"></i> Delete
                    </button>
                  </form>
                </td>
              </tr>
              <% }) %>
                <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Pagination -->
<% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
  <nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center flex-wrap gap-2">
      <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
        <a class="page-link rounded"
          href="?page=<%= currentPage - 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>">Previous</a>
      </li>
      <% for (let i=1; i <=totalPages; i++) { %>
        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
          <a class="page-link rounded"
            href="?page=<%= i %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>">
            <%= i %>
          </a>
        </li>
        <% } %>
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link rounded"
              href="?page=<%= currentPage + 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>">Next</a>
          </li>
    </ul>
  </nav>
  <% } %>