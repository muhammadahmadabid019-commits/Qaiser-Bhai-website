<div class="mb-4">
  <a href="/admin/categories" class="text-decoration-none text-muted"><i class="fas fa-arrow-left"></i> Back to Categories</a>
  <h2 style="font-weight: 700; color: #082044; margin-top: 10px;">Edit Category: <%= category.name %></h2>
</div>

<div class="card-box" style="max-width: 800px;">
  <form id="categoryForm" action="/admin/categories/edit/<%= category._id %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row g-3">
      <div class="col-md-12 mb-3">
        <label class="form-label fw-bold">Category Name <span class="text-danger">*</span></label>
        <input type="text" name="name" class="form-control" value="<%= category.name %>" required>
      </div>

      <div class="col-12 mb-3">
        <label class="form-label fw-bold">Description</label>
        <textarea name="description" class="form-control" rows="3"><%= category.description %></textarea>
      </div>

      <div class="col-12 mb-3">
        <label class="form-label fw-bold">Category Type <span class="text-danger">*</span></label>
        <select name="type" id="typeSelect" class="form-control" required onchange="toggleServiceFields()">
          <option value="product" <%= category.type === 'product' ? 'selected' : '' %>>Product &mdash; sells physical items (shows in Add Product dropdown)</option>
          <option value="service" <%= category.type === 'service' ? 'selected' : '' %>>Service &mdash; shows as a card on the homepage Services section</option>
        </select>
      </div>

      <div id="serviceFields" style="display:none;">
        <div class="col-12 mb-3">
          <label class="form-label fw-bold">Service Image</label>
          <% if (category.image) { %>
            <div class="mb-2">
              <img src="<%= category.image %>" alt="Current Image" style="max-height: 100px; border-radius: 4px; border: 1px solid #ccc;">
            </div>
          <% } %>
          <input type="file" name="image" class="form-control" accept="image/*">
          <small class="text-muted">Upload a new image to replace the current one. If no image exists, the icon below is used.</small>
        </div>

        <div class="col-12 mb-3">
          <label class="form-label fw-bold">Icon (FontAwesome class) - Fallback</label>
          <input type="text" name="icon" class="form-control" value="<%= category.icon %>" placeholder="e.g. fa-camera, fa-network-wired, fa-headset">
          <small class="text-muted">Browse icons at <a href="https://fontawesome.com/search?o=r&m=free" target="_blank">fontawesome.com</a>. Just the icon name, e.g. "fa-camera".</small>
        </div>

        <div class="col-12 mb-3">
          <label class="form-label fw-bold">Feature Bullets (one per line)</label>
          <textarea name="features" class="form-control" rows="4"><%= (category.features || []).join('\n') %></textarea>
          <small class="text-muted">Each line becomes a checkmark bullet point on the service card.</small>
        </div>

        <div class="col-12 mb-4 form-check">
          <input type="checkbox" name="featured" class="form-check-input" id="featuredCheck" <%= category.featured ? 'checked' : '' %>>
          <label class="form-check-label" for="featuredCheck">Mark as "Most Popular" (highlighted card)</label>
        </div>
      </div>

      <div class="col-12 text-end">
        <a href="/admin/categories" class="btn btn-light me-2">Cancel</a>
        <button type="submit" class="btn btn-admin-primary">
          <i class="fas fa-save"></i> Update Category
        </button>
      </div>
    </div>
  </form>
</div>

<script>
  document.getElementById('categoryForm').addEventListener('submit', async function(e) {
    const typeSelect = document.getElementById('typeSelect');
    if (typeSelect && typeSelect.value === 'product') {
      // Let the browser handle the form submission natively for products
      return;
    }

    e.preventDefault();
    const btn = this.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    
    try {
      const response = await fetch(this.action, {
        method: this.method,
        body: new FormData(this),
        headers: {
          'X-CSRF-Token': '<%= csrfToken %>'
        }
      });
      
      if (response.redirected) {
        window.history.pushState(null, "", response.url);
        const html = await response.text();
        document.open();
        document.write(html);
        document.close();
      } else {
        window.location.reload();
      }
    } catch (err) {
      console.error(err);
      window.location.reload();
    }
  });
</script>

<script>
  function toggleServiceFields() {
    const type = document.getElementById('typeSelect').value;
    document.getElementById('serviceFields').style.display = (type === 'service') ? 'block' : 'none';
  }
  // Run on page load so it's correct when editing an existing service category
  toggleServiceFields();
</script>
