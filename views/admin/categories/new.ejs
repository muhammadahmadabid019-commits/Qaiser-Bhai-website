<div class="mb-4">
  <a href="/admin/categories" class="text-decoration-none text-muted"><i class="fas fa-arrow-left"></i> Back to Categories</a>
  <h2 style="font-weight: 700; color: #0F2A4A; margin-top: 10px;">Add New Category</h2>
</div>

<div class="card-box" style="max-width: 800px;">
  <form id="categoryForm" action="/admin/categories" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row g-3">
      <div class="col-md-12 mb-3">
        <label class="form-label fw-bold">Category Name <span class="text-danger">*</span></label>
        <input type="text" name="name" class="form-control" required>
      </div>

      <div class="col-12 mb-3">
        <label class="form-label fw-bold">Description</label>
        <textarea name="description" class="form-control" rows="3"></textarea>
      </div>

      <div class="col-12 mb-3">
        <label class="form-label fw-bold">Category Type <span class="text-danger">*</span></label>
        <select name="type" id="typeSelect" class="form-control" required onchange="toggleServiceFields()">
          <option value="product">Product &mdash; sells physical items (shows in Add Product dropdown)</option>
          <option value="service">Service &mdash; shows as a card on the homepage Services section</option>
        </select>
      </div>

      <div id="serviceFields" style="display:none;">
        <div class="col-12 mb-3">
          <label class="form-label fw-bold">Service Image</label>
          <input type="file" name="image" class="form-control" accept="image/*">
          <small class="text-muted">Will be displayed on the homepage cards. If left empty, the icon below is used.</small>
        </div>

        <div class="col-12 mb-3">
          <label class="form-label fw-bold">Icon (FontAwesome class) - Fallback</label>
          <input type="text" name="icon" class="form-control" placeholder="e.g. fa-camera, fa-network-wired, fa-headset">
          <small class="text-muted">Browse icons at <a href="https://fontawesome.com/search?o=r&m=free" target="_blank">fontawesome.com</a>. Just the icon name, e.g. "fa-camera".</small>
        </div>

        <div class="col-12 mb-3">
          <label class="form-label fw-bold">Feature Bullets (one per line)</label>
          <textarea name="features" class="form-control" rows="4" placeholder="HD & 4K Cameras&#10;Remote Monitoring&#10;24/7 Support"></textarea>
          <small class="text-muted">Each line becomes a checkmark bullet point on the service card.</small>
        </div>

        <div class="col-12 mb-4 form-check">
          <input type="checkbox" name="featured" class="form-check-input" id="featuredCheck">
          <label class="form-check-label" for="featuredCheck">Mark as "Most Popular" (highlighted card)</label>
        </div>
      </div>

      <div class="col-12 text-end">
        <a href="/admin/categories" class="btn btn-light me-2">Cancel</a>
        <button type="submit" class="btn btn-admin-primary">
          <i class="fas fa-save"></i> Save Category
        </button>
      </div>
    </div>
  </form>
</div>

<script>
  document.getElementById('categoryForm').addEventListener('submit', async function(e) {
    const typeSelect = document.getElementById('typeSelect');
    if (typeSelect && typeSelect.value === 'product') {
      // Let the browser handle the form submission natively for products
      return;
    }

    e.preventDefault();
    const btn = this.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    
    try {
      const response = await fetch(this.action, {
        method: this.method,
        body: new FormData(this),
        headers: {
          'X-CSRF-Token': '<%= csrfToken %>'
        }
      });
      
      if (response.redirected) {
        window.history.pushState(null, "", response.url);
        const html = await response.text();
        document.open();
        document.write(html);
        document.close();
      } else {
        window.location.reload();
      }
    } catch (err) {
      console.error(err);
      window.location.reload();
    }
  });
</script>

<script>
  function toggleServiceFields() {
    const type = document.getElementById('typeSelect').value;
    document.getElementById('serviceFields').style.display = (type === 'service') ? 'block' : 'none';
  }
</script>
