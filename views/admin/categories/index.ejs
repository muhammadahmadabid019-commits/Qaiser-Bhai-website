<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 style="font-weight: 700; color: #0F2A4A;">Manage Categories</h2>
  <a href="/admin/categories/new" class="btn btn-admin-primary">
    <i class="fas fa-plus"></i> Add New Category
  </a>
</div>

<div class="row mb-4">
  <div class="col-12 col-md-8 col-lg-5">
    <form action="/admin/categories" method="GET">
      <div class="input-group">
        <input type="text" name="search" class="form-control" placeholder="Search categories..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        <button class="btn btn-admin-primary" type="submit"><i class="fas fa-search me-1"></i> Search</button>
        <% if (typeof search !== 'undefined' && search) { %>
          <a href="/admin/categories" class="btn btn-outline-secondary">Clear</a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<div class="card-box">
  <div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Type</th>
        <th scope="col">Description</th>
        <th scope="col">Subcategories</th>
        <th scope="col">Products</th>
        <th scope="col" class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (categories.length === 0) { %>
        <tr>
          <td colspan="6" class="text-center py-4">
            <% if (typeof search !== 'undefined' && search) { %>
              No categories found matching your search.
            <% } else { %>
              No categories found. Start by adding one!
            <% } %>
          </td>
        </tr>
      <% } else { %>
        <% categories.forEach(category => { %>
          <tr>
            <td class="fw-semibold"><%= category.name %></td>
            <td>
              <% if (category.type === 'service') { %>
                <span class="badge bg-info text-dark">Service</span>
              <% } else { %>
                <span class="badge bg-secondary">Product</span>
              <% } %>
            </td>
            <td class="text-muted"><%= category.description %></td>
            <td><span class="badge bg-secondary"><%= counts[category._id].subcategories %></span></td>
            <td><span class="badge bg-secondary"><%= counts[category._id].products %></span></td>
            <td class="text-end">
              <a href="/admin/categories/edit/<%= category._id %>" class="btn btn-sm btn-outline-primary me-2">
                <i class="fas fa-edit"></i> Edit
              </a>
              <form action="/admin/categories/delete/<%= category._id %>" method="POST" class="d-inline" onsubmit="return confirm('WARNING: Are you sure you want to permanently delete this category?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  <i class="fas fa-trash"></i> Delete
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
  </div>
</div>
