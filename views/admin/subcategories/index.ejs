<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 style="font-weight: 700; color: #0A2347;">Manage Subcategories</h2>
  <a href="/admin/subcategories/new" class="btn btn-admin-primary">
    <i class="fas fa-plus"></i> Add New Subcategory
  </a>
</div>

<div class="row mb-4">
  <div class="col-12 col-md-8 col-lg-5">
    <form action="/admin/subcategories" method="GET">
      <div class="input-group">
        <input type="text" name="search" class="form-control" placeholder="Search by subcategory or parent..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        <button class="btn btn-admin-primary" type="submit"><i class="fas fa-search me-1"></i> Search</button>
        <% if (typeof search !== 'undefined' && search) { %>
          <a href="/admin/subcategories" class="btn btn-outline-secondary">Clear</a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<div class="card-box">
  <div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Category</th>
        <th scope="col">Products</th>
        <th scope="col" class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (subcategories.length === 0) { %>
        <tr>
          <td colspan="4" class="text-center py-4">
            <% if (typeof search !== 'undefined' && search) { %>
              No subcategories found matching your search.
            <% } else { %>
              No subcategories found. Start by adding one!
            <% } %>
          </td>
        </tr>
      <% } else { %>
        <% subcategories.forEach(sub => { %>
          <tr>
            <td class="fw-semibold"><%= sub.name %></td>
            <td><span class="badge bg-secondary"><%= sub.category ? sub.category.name : 'None' %></span></td>
            <td><span class="badge bg-secondary"><%= counts[sub._id] %></span></td>
            <td class="text-end">
              <a href="/admin/subcategories/edit/<%= sub._id %>" class="btn btn-sm btn-outline-primary me-2">
                <i class="fas fa-edit"></i> Edit
              </a>
              <form action="/admin/subcategories/delete/<%= sub._id %>" method="POST" class="d-inline" onsubmit="return confirm('WARNING: Are you sure you want to permanently delete this subcategory?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  <i class="fas fa-trash"></i> Delete
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
  </div>
</div>
