<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h2 style="font-weight: 700; color: #0a1628;">Quote Requests</h2>
  <div class="d-flex align-items-center gap-2">
    <span class="badge bg-secondary" id="totalCountBadge"><%= quotes.length %> total</span>
    <a href="#" id="exportCsvBtn" class="btn btn-sm btn-outline-primary">
      <i class="fas fa-file-csv"></i> Export CSV
    </a>
  </div>
</div>

<!-- Search & Filters -->
<div class="card-box mb-3">
  <div class="row g-2 align-items-center">
    <div class="col-md-4">
      <input type="search" id="quoteSearch" class="form-control" placeholder="Search by name, phone, or email...">
    </div>
    <div class="col-md-5">
      <div class="btn-group" role="group" aria-label="Filter by status" id="statusFilterGroup">
        <button type="button" class="btn btn-outline-secondary status-filter-btn" data-status="">All</button>
        <% quoteStatuses.forEach(s => { %>
          <button type="button" class="btn btn-outline-secondary status-filter-btn" data-status="<%= s %>"><%= s %></button>
        <% }) %>
      </div>
    </div>
    <div class="col-md-3">
      <select id="sortSelect" class="form-select">
        <option value="newest">Newest First</option>
        <option value="oldest">Oldest First</option>
      </select>
    </div>
  </div>
</div>

<!-- Bulk Actions Toolbar (shown only when 1+ rows selected) -->
<div class="card-box mb-3 d-none" id="bulkToolbar">
  <div class="d-flex flex-wrap align-items-center gap-2">
    <strong id="bulkSelectedCount">0 selected</strong>
    <div class="d-flex align-items-center gap-1 ms-md-3">
      <select id="bulkStatusSelect" class="form-select form-select-sm" style="width:auto;" aria-label="Bulk status">
        <% quoteStatuses.forEach(s => { %>
          <option value="<%= s %>"><%= s %></option>
        <% }) %>
      </select>
      <button type="button" id="bulkStatusApplyBtn" class="btn btn-sm btn-outline-primary">Update Status</button>
    </div>
    <button type="button" id="bulkDeleteBtn" class="btn btn-sm btn-outline-danger ms-md-2">
      <i class="fas fa-trash"></i> Delete Selected
    </button>
  </div>
</div>

<div class="card-box">
  <div id="emptyState" class="text-center py-5 d-none">
    <i class="fas fa-inbox mb-3" style="font-size: 2.5rem; opacity: 0.3;"></i>
    <p class="text-muted mb-0" id="emptyStateMessage">No quote requests found.</p>
  </div>

  <div class="table-responsive" id="tableWrapper">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th scope="col"><input type="checkbox" id="selectAllCheckbox" aria-label="Select all quote requests"></th>
          <th scope="col">Name</th>
          <th scope="col">Phone</th>
          <th scope="col">Email</th>
          <th scope="col">Service</th>
          <th scope="col">Message</th>
          <th scope="col">Date</th>
          <th scope="col">Status</th>
          <th scope="col" class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody id="quotesTableBody"></tbody>
    </table>
  </div>
</div>

<!-- Quote Details Modal -->
<div class="modal fade" id="quoteDetailsModal" tabindex="-1" aria-labelledby="quoteDetailsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="quoteDetailsModalLabel">Quote Request Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="quoteDetailsBody"><!-- populated by JS --></div>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal (reused for single + bulk delete) -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteConfirmModalLabel">Delete Quote Request?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p id="deleteConfirmMessage" class="mb-0">This action cannot be undone.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="deleteConfirmBtn">Delete</button>
      </div>
    </div>
  </div>
</div>

<!-- Toast container -->
<div id="toastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>

<style>
  .status-filter-btn.active { background-color: #1a73e8; color: #fff; border-color: #1a73e8; }
  .quote-message-preview { max-width: 260px; white-space: normal; word-break: break-word; }
  .quote-status-select { min-width: 130px; }
  @media (max-width: 767px) {
    #statusFilterGroup { flex-wrap: wrap; }
    #statusFilterGroup .btn { flex: 1 1 auto; }
  }
</style>

<script>
(function() {
  const QUOTE_STATUSES = <%- JSON.stringify(quoteStatuses) %>;
  let quotes = <%- JSON.stringify(quotes.map(q => ({
    id: q._id.toString(),
    name: q.name,
    phone: q.phone,
    email: q.email,
    service: q.service,
    message: q.message || '',
    status: q.status,
    createdAt: q.createdAt.toISOString()
  }))) %>;

  const selectedIds = new Set();
  const filters = { status: <%- JSON.stringify(initialStatusFilter) %>, search: '', sort: 'newest' };

  const $tbody = document.getElementById('quotesTableBody');
  const $emptyState = document.getElementById('emptyState');
  const $emptyStateMessage = document.getElementById('emptyStateMessage');
  const $tableWrapper = document.getElementById('tableWrapper');
  const $totalBadge = document.getElementById('totalCountBadge');
  const $selectAll = document.getElementById('selectAllCheckbox');
  const $bulkToolbar = document.getElementById('bulkToolbar');
  const $bulkCount = document.getElementById('bulkSelectedCount');

  function escapeHtml(str) {
    return String(str == null ? '' : str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function formatDate(iso) {
    return new Date(iso).toLocaleDateString('en-PK', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  function statusBadgeClass(status) {
    if (status === 'Closed') return 'bg-secondary';
    if (status === 'In Progress') return 'bg-info text-dark';
    return 'bg-warning text-dark'; // New
  }

  function showToast(message, variant) {
    variant = variant || 'success';
    const id = 'toast-' + Date.now() + '-' + Math.floor(Math.random() * 1000);
    const wrapper = document.createElement('div');
    wrapper.innerHTML = `<div id="${id}" class="toast align-items-center text-bg-${variant} border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body">${escapeHtml(message)}</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>`;
    const toastEl = wrapper.firstElementChild;
    document.getElementById('toastContainer').appendChild(toastEl);
    const toast = new bootstrap.Toast(toastEl, { delay: 3500 });
    toast.show();
    toastEl.addEventListener('hidden.bs.toast', function() { toastEl.remove(); });
  }

  function getFiltered() {
    let list = quotes.filter(function(q) {
      if (filters.status && q.status !== filters.status) return false;
      if (filters.search) {
        const s = filters.search.toLowerCase();
        if (!q.name.toLowerCase().includes(s) && !q.phone.toLowerCase().includes(s) && !q.email.toLowerCase().includes(s)) {
          return false;
        }
      }
      return true;
    });
    list.sort(function(a, b) {
      const da = new Date(a.createdAt), db = new Date(b.createdAt);
      return filters.sort === 'oldest' ? da - db : db - da;
    });
    return list;
  }

  function truncate(text, max) {
    if (!text) return '—';
    if (text.length <= max) return escapeHtml(text);
    return escapeHtml(text.slice(0, max)) + '&hellip; <a href="#" class="read-more-link" data-id="__ID__">Read More</a>';
  }

  function render() {
    const list = getFiltered();
    $totalBadge.textContent = quotes.length + ' total';

    if (quotes.length === 0) {
      $tableWrapper.classList.add('d-none');
      $emptyState.classList.remove('d-none');
      $emptyStateMessage.textContent = 'No quote requests found.';
      updateBulkToolbar();
      return;
    }
    if (list.length === 0) {
      $tableWrapper.classList.add('d-none');
      $emptyState.classList.remove('d-none');
      $emptyStateMessage.textContent = 'No quote requests match the selected filters.';
      updateBulkToolbar();
      return;
    }

    $tableWrapper.classList.remove('d-none');
    $emptyState.classList.add('d-none');

    $tbody.innerHTML = list.map(function(q) {
      const checked = selectedIds.has(q.id) ? 'checked' : '';
      const msgHtml = truncate(q.message, 90).replace('__ID__', q.id);
      const statusOptions = QUOTE_STATUSES.map(function(s) {
        return `<option value="${s}" ${s === q.status ? 'selected' : ''}>${s}</option>`;
      }).join('');
      return `<tr data-id="${q.id}">
        <td><input type="checkbox" class="row-checkbox" data-id="${q.id}" aria-label="Select quote from ${escapeHtml(q.name)}" ${checked}></td>
        <td class="fw-semibold">${escapeHtml(q.name)}</td>
        <td><a href="tel:${escapeHtml(q.phone)}">${escapeHtml(q.phone)}</a></td>
        <td><a href="mailto:${escapeHtml(q.email)}">${escapeHtml(q.email)}</a></td>
        <td>${escapeHtml(q.service)}</td>
        <td class="quote-message-preview">${msgHtml}</td>
        <td class="text-muted">${formatDate(q.createdAt)}</td>
        <td>
          <select class="form-select form-select-sm quote-status-select status-badge-${q.status.replace(/\\s+/g,'-')}" data-id="${q.id}" aria-label="Status for quote from ${escapeHtml(q.name)}">
            ${statusOptions}
          </select>
        </td>
        <td class="text-end">
          <button type="button" class="btn btn-sm btn-outline-primary view-details-btn" data-id="${q.id}"><i class="fas fa-eye"></i></button>
          <button type="button" class="btn btn-sm btn-outline-danger delete-btn" data-id="${q.id}"><i class="fas fa-trash"></i></button>
        </td>
      </tr>`;
    }).join('');

    // Keep header checkbox in sync with the current visible selection
    const visibleIds = list.map(function(q) { return q.id; });
    const allVisibleSelected = visibleIds.length > 0 && visibleIds.every(function(id) { return selectedIds.has(id); });
    $selectAll.checked = allVisibleSelected;
    $selectAll.indeterminate = !allVisibleSelected && visibleIds.some(function(id) { return selectedIds.has(id); });

    updateBulkToolbar();
  }

  function updateBulkToolbar() {
    if (selectedIds.size > 0) {
      $bulkToolbar.classList.remove('d-none');
      $bulkCount.textContent = selectedIds.size + ' selected';
    } else {
      $bulkToolbar.classList.add('d-none');
    }
  }

  // --- Search / filter / sort ---
  document.getElementById('quoteSearch').addEventListener('input', function(e) {
    filters.search = e.target.value;
    render();
  });
  document.getElementById('sortSelect').addEventListener('change', function(e) {
    filters.sort = e.target.value;
    render();
  });
  const filterBtns = document.querySelectorAll('.status-filter-btn');
  function setActiveFilterBtn() {
    filterBtns.forEach(function(btn) {
      btn.classList.toggle('active', btn.dataset.status === filters.status);
    });
  }
  filterBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      filters.status = btn.dataset.status;
      setActiveFilterBtn();
      render();
    });
  });
  setActiveFilterBtn();

  // --- Row selection ---
  $tbody.addEventListener('change', function(e) {
    if (e.target.classList.contains('row-checkbox')) {
      const id = e.target.dataset.id;
      if (e.target.checked) selectedIds.add(id); else selectedIds.delete(id);
      updateBulkToolbar();
      const visibleIds = getFiltered().map(function(q) { return q.id; });
      const allVisibleSelected = visibleIds.length > 0 && visibleIds.every(function(vid) { return selectedIds.has(vid); });
      $selectAll.checked = allVisibleSelected;
      $selectAll.indeterminate = !allVisibleSelected && visibleIds.some(function(vid) { return selectedIds.has(vid); });
    }
  });
  $selectAll.addEventListener('change', function() {
    const visible = getFiltered();
    if ($selectAll.checked) {
      visible.forEach(function(q) { selectedIds.add(q.id); });
    } else {
      visible.forEach(function(q) { selectedIds.delete(q.id); });
    }
    render();
  });

  // --- Auto-save single status change ---
  $tbody.addEventListener('change', function(e) {
    if (!e.target.classList.contains('quote-status-select')) return;
    const id = e.target.dataset.id;
    const newStatus = e.target.value;
    const quote = quotes.find(function(q) { return q.id === id; });
    const previousStatus = quote ? quote.status : null;

    fetch('/admin/quotes/' + id + '/status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: newStatus })
    })
      .then(function(r) { return r.json().then(function(body) { return { ok: r.ok, body: body }; }); })
      .then(function(res) {
        if (!res.ok || !res.body.success) throw new Error(res.body.message || 'Failed to update status.');
        if (quote) quote.status = newStatus;
        showToast(res.body.message || 'Quote status updated successfully.');
        render();
      })
      .catch(function(err) {
        if (quote) e.target.value = previousStatus; // revert the dropdown
        showToast(err.message || 'Failed to update status.', 'danger');
      });
  });

  // --- View Details / Read More (same modal) ---
  function openDetailsModal(id) {
    const q = quotes.find(function(item) { return item.id === id; });
    if (!q) return;
    const statusOptions = QUOTE_STATUSES.map(function(s) {
      return `<option value="${s}" ${s === q.status ? 'selected' : ''}>${s}</option>`;
    }).join('');
    document.getElementById('quoteDetailsBody').innerHTML = `
      <h6 class="text-muted mb-2">Customer Information</h6>
      <p class="mb-1"><strong>${escapeHtml(q.name)}</strong></p>
      <p class="mb-1"><a href="mailto:${escapeHtml(q.email)}">${escapeHtml(q.email)}</a></p>
      <p class="mb-3"><a href="tel:${escapeHtml(q.phone)}">${escapeHtml(q.phone)}</a></p>
      <h6 class="text-muted mb-2">Requested Service</h6>
      <p class="mb-3">${escapeHtml(q.service)}</p>
      <h6 class="text-muted mb-2">Message</h6>
      <p class="mb-3" style="white-space: pre-wrap;">${escapeHtml(q.message) || '—'}</p>
      <div class="row">
        <div class="col-sm-6">
          <h6 class="text-muted mb-2">Submission Date</h6>
          <p class="mb-0">${formatDate(q.createdAt)}</p>
        </div>
        <div class="col-sm-6">
          <h6 class="text-muted mb-2">Status</h6>
          <select class="form-select form-select-sm quote-status-select" data-id="${q.id}" style="max-width: 200px;">
            ${statusOptions}
          </select>
        </div>
      </div>
    `;
    new bootstrap.Modal(document.getElementById('quoteDetailsModal')).show();
  }

  $tbody.addEventListener('click', function(e) {
    const viewBtn = e.target.closest('.view-details-btn');
    const readMore = e.target.closest('.read-more-link');
    if (viewBtn) { openDetailsModal(viewBtn.dataset.id); }
    if (readMore) { e.preventDefault(); openDetailsModal(readMore.dataset.id); }
  });
  // Status changes made from inside the modal reuse the same auto-save
  // handler by delegating through the same class + fetch call.
  document.getElementById('quoteDetailsBody').addEventListener('change', function(e) {
    if (!e.target.classList.contains('quote-status-select')) return;
    const id = e.target.dataset.id;
    const newStatus = e.target.value;
    const quote = quotes.find(function(q) { return q.id === id; });
    const previousStatus = quote ? quote.status : null;

    fetch('/admin/quotes/' + id + '/status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: newStatus })
    })
      .then(function(r) { return r.json().then(function(body) { return { ok: r.ok, body: body }; }); })
      .then(function(res) {
        if (!res.ok || !res.body.success) throw new Error(res.body.message || 'Failed to update status.');
        if (quote) quote.status = newStatus;
        showToast(res.body.message || 'Quote status updated successfully.');
        render();
      })
      .catch(function(err) {
        if (quote) e.target.value = previousStatus;
        showToast(err.message || 'Failed to update status.', 'danger');
      });
  });

  // --- Delete (single + bulk share one confirm modal) ---
  let pendingDeleteIds = [];
  // Lazily created on first use, same as openDetailsModal() above — this
  // script runs before admin-layout.ejs's bootstrap.bundle.min.js <script>
  // tag (body content loads before that script, see admin-layout.ejs), so
  // `bootstrap` does not exist yet at the top level of this file. Calling
  // `new bootstrap.Modal(...)` eagerly here throws a ReferenceError that
  // silently aborts the rest of this script — including render() and the
  // delete button's own click listener below. Deferring construction until
  // a click actually happens (well after every script has loaded) avoids
  // that entirely.
  let _deleteModal = null;
  function getDeleteModal() {
    if (!_deleteModal) {
      _deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
    }
    return _deleteModal;
  }

  $tbody.addEventListener('click', function(e) {
    const btn = e.target.closest('.delete-btn');
    if (!btn) return;
    pendingDeleteIds = [btn.dataset.id];
    document.getElementById('deleteConfirmMessage').textContent = 'This action cannot be undone.';
    getDeleteModal().show();
  });

  document.getElementById('bulkDeleteBtn').addEventListener('click', function() {
    pendingDeleteIds = Array.from(selectedIds);
    document.getElementById('deleteConfirmMessage').textContent =
      'You are about to permanently delete ' + pendingDeleteIds.length + ' quote request(s). This action cannot be undone.';
    getDeleteModal().show();
  });

  document.getElementById('deleteConfirmBtn').addEventListener('click', function() {
    if (pendingDeleteIds.length === 0) return;
    const isBulk = pendingDeleteIds.length > 1;
    const url = isBulk ? '/admin/quotes/bulk/delete' : '/admin/quotes/delete/' + pendingDeleteIds[0];
    const payload = isBulk ? JSON.stringify({ ids: pendingDeleteIds }) : undefined;

    fetch(url, {
      method: 'POST',
      headers: isBulk ? { 'Content-Type': 'application/json' } : {},
      body: payload
    })
      .then(function(r) { return r.json().then(function(body) { return { ok: r.ok, body: body }; }); })
      .then(function(res) {
        if (!res.ok || !res.body.success) throw new Error(res.body.message || 'Failed to delete.');
        const deletedSet = new Set(pendingDeleteIds);
        quotes = quotes.filter(function(q) { return !deletedSet.has(q.id); });
        pendingDeleteIds.forEach(function(id) { selectedIds.delete(id); });
        getDeleteModal().hide();
        showToast(res.body.message || (isBulk ? 'Quote requests deleted.' : 'Quote deleted.'));
        render();
      })
      .catch(function(err) {
        getDeleteModal().hide();
        showToast(err.message || 'Failed to delete.', 'danger');
      });
  });

  // --- Bulk status update ---
  document.getElementById('bulkStatusApplyBtn').addEventListener('click', function() {
    const ids = Array.from(selectedIds);
    if (ids.length === 0) return;
    const status = document.getElementById('bulkStatusSelect').value;

    fetch('/admin/quotes/bulk/status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids: ids, status: status })
    })
      .then(function(r) { return r.json().then(function(body) { return { ok: r.ok, body: body }; }); })
      .then(function(res) {
        if (!res.ok || !res.body.success) throw new Error(res.body.message || 'Failed to update selected quote requests.');
        const idSet = new Set(ids);
        quotes.forEach(function(q) { if (idSet.has(q.id)) q.status = status; });
        showToast(res.body.message || 'Quote requests updated successfully.');
        render();
      })
      .catch(function(err) {
        showToast(err.message || 'Failed to update selected quote requests.', 'danger');
      });
  });

  // --- Export CSV (respects active filters) ---
  document.getElementById('exportCsvBtn').addEventListener('click', function(e) {
    e.preventDefault();
    const params = new URLSearchParams();
    if (filters.status) params.set('status', filters.status);
    if (filters.search) params.set('search', filters.search);
    params.set('sort', filters.sort);
    window.location.href = '/admin/quotes/export?' + params.toString();
    showToast('Export started — your download will begin shortly.');
  });

  render();
})();
</script>
