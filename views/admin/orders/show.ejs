<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <a href="/admin/orders" class="text-decoration-none small"><i class="fas fa-arrow-left me-1"></i>Back to Orders</a>
    <h2 class="mt-1 mb-0" style="font-weight: 700; color: #0F2A4A;">
      Order #<%= order._id.toString().slice(-8).toUpperCase() %>
    </h2>
  </div>
  <div>
    <% if (order.status === 'Delivered') { %>
      <span class="badge bg-success fs-6"><%= order.status %></span>
    <% } else if (order.status === 'Cancelled') { %>
      <span class="badge bg-danger fs-6"><%= order.status %></span>
    <% } else if (order.status === 'Processing' || order.status === 'Shipped') { %>
      <span class="badge bg-info text-dark fs-6"><%= order.status %></span>
    <% } else { %>
      <span class="badge bg-secondary fs-6"><%= order.status %></span>
    <% } %>
  </div>
</div>

<div class="row g-3">

  <!-- Customer Information -->
  <div class="col-md-6">
    <div class="card-box h-100">
      <h5 class="mb-3"><i class="fas fa-user me-2"></i>Customer Information</h5>
      <p class="mb-1"><strong>Name:</strong> <%= order.customerName %></p>
      <p class="mb-1"><strong>Email:</strong> <%= order.email ? order.email : '—' %></p>
      <p class="mb-0"><strong>Phone:</strong> <a href="tel:<%= order.phone %>"><%= order.phone %></a></p>
    </div>
  </div>

  <!-- Shipping Information -->
  <div class="col-md-6">
    <div class="card-box h-100">
      <h5 class="mb-3"><i class="fas fa-map-marker-alt me-2"></i>Shipping Information</h5>
      <p class="mb-1">
        <strong>Address:</strong>
        <%= [order.shippingAddress.houseNo, order.shippingAddress.street, order.shippingAddress.area].filter(Boolean).join(', ') %>
      </p>
      <p class="mb-1">
        <strong>City / Province:</strong>
        <%= [order.shippingAddress.city, order.shippingAddress.province].filter(Boolean).join(', ') %>
      </p>
      <p class="mb-0"><strong>Postal Code:</strong> <%= order.shippingAddress.postalCode || '—' %></p>
    </div>
  </div>

  <!-- Order Information -->
  <div class="col-12">
    <div class="card-box">
      <h5 class="mb-3"><i class="fas fa-box me-2"></i>Order Information</h5>
      <p class="mb-3 text-muted">
        Order Date: <%= order.createdAt.toLocaleString('en-PK') %> &middot;
        Delivery Method: <%= order.deliveryMethod %>
      </p>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead class="table-light">
            <tr>
              <th>Product</th>
              <th>Quantity</th>
              <th>Unit Price</th>
              <th class="text-end">Line Total</th>
            </tr>
          </thead>
          <tbody>
            <% order.items.forEach(item => { %>
              <tr>
                <td><%= item.name %></td>
                <td><%= item.quantity %></td>
                <td><%= formatPrice(item.price) %></td>
                <td class="text-end"><%= formatPrice(item.price * item.quantity) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="row justify-content-end">
        <div class="col-md-4">
          <div class="d-flex justify-content-between"><span>Subtotal</span><span><%= formatPrice(order.subtotal) %></span></div>
          <div class="d-flex justify-content-between">
            <span>Shipping</span><span><%= order.deliveryFee === 0 ? 'FREE' : formatPrice(order.deliveryFee) %></span>
          </div>
          <div class="d-flex justify-content-between"><span>Tax</span><span><%= formatPrice(order.tax) %></span></div>
          <hr class="my-2">
          <div class="d-flex justify-content-between fw-bold fs-5">
            <span>Grand Total</span><span><%= formatPrice(order.totalAmount) %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Payment Information -->
  <div class="col-12" id="payment-verification">
    <div class="card-box">
      <h5 class="mb-3"><i class="fas fa-credit-card me-2"></i>Payment Information</h5>
      <div class="row g-3 mb-3">
        <div class="col-md-4">
          <p class="mb-0 text-muted small">Payment Method</p>
          <p class="mb-0 fw-semibold"><%= order.paymentMethod %></p>
        </div>
        <div class="col-md-4">
          <p class="mb-0 text-muted small">Payment Status</p>
          <p class="mb-0">
            <% if (order.paymentStatus === 'Paid') { %>
              <span class="badge bg-success"><%= order.paymentStatus %></span>
            <% } else if (order.paymentStatus === 'Pending Verification') { %>
              <span class="badge bg-warning text-dark"><%= order.paymentStatus %></span>
            <% } else if (order.paymentStatus === 'Failed') { %>
              <span class="badge bg-danger"><%= order.paymentStatus %></span>
            <% } else { %>
              <span class="badge bg-secondary"><%= order.paymentStatus %></span>
            <% } %>
          </p>
        </div>
        <div class="col-md-4">
          <p class="mb-0 text-muted small">Transaction Reference</p>
          <p class="mb-0 fw-semibold"><%= order.transactionReference ? order.transactionReference : '—' %></p>
        </div>
      </div>

      <% if (order.paymentStatus === 'Paid' && order.paymentApprovedAt) { %>
        <div class="alert alert-success py-2 px-3 mb-3 small">
          <i class="fas fa-check-circle me-1"></i>
          Approved by <%= order.paymentApprovedBy ? order.paymentApprovedBy.name : 'an admin' %> on <%= new Date(order.paymentApprovedAt).toLocaleString('en-PK') %>.
        </div>
      <% } else if (order.paymentStatus === 'Failed' && order.paymentRejectionReason) { %>
        <div class="alert alert-danger py-2 px-3 mb-3 small">
          <i class="fas fa-exclamation-triangle me-1"></i>
          <strong>Rejection reason:</strong> <%= order.paymentRejectionReason %>
        </div>
      <% } %>

      <% if (order.paymentMethod === 'Bank Transfer') { %>
        <div class="mb-3">
          <p class="mb-1 text-muted small">Payment Receipt</p>
          <% if (order.paymentProof) { %>
            <% if (/\.(jpe?g|png|webp)$/i.test(order.paymentProof)) { %>
              <a href="/admin/orders/<%= order._id %>/receipt" target="_blank">
                <img src="/admin/orders/<%= order._id %>/receipt" alt="Payment receipt preview" class="img-thumbnail" style="max-height: 160px;">
              </a>
            <% } %>
            <div class="mt-2">
              <a href="/admin/orders/<%= order._id %>/receipt" target="_blank" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-eye me-1"></i>View Receipt
              </a>
              <a href="/admin/orders/<%= order._id %>/receipt" download class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-download me-1"></i>Download Receipt
              </a>
              <% if (order.paymentSubmittedAt) { %>
                <span class="text-muted small ms-2">Submitted <%= new Date(order.paymentSubmittedAt).toLocaleString('en-PK') %></span>
              <% } %>
            </div>
          <% } else { %>
            <p class="mb-0 text-muted small fst-italic">No receipt uploaded yet.</p>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Order Actions: context-aware business actions, not a raw status dropdown -->
  <div class="col-12">
    <div class="card-box">
      <h5 class="mb-3"><i class="fas fa-tasks me-2"></i>Order Actions</h5>

      <% if (workflow.display) { %>
        <span class="badge <%= workflow.display === 'Completed' ? 'bg-success' : 'bg-danger' %> fs-6">
          <% if (workflow.display === 'Completed') { %><i class="fas fa-check-circle me-1"></i><% } %>
          <%= workflow.display %>
        </span>
      <% } else { %>
        <% if (workflow.note) { %>
          <p class="text-muted small mb-3"><i class="fas fa-info-circle me-1"></i><%= workflow.note %></p>
        <% } %>

        <div class="d-flex flex-wrap gap-2">
          <% workflow.actions.forEach(action => { %>
            <% if (action.key === 'rejectPayment') { %>
              <button type="button" class="btn <%= action.btnClass %> order-action-btn" id="showRejectFormBtn">
                <i class="fas <%= action.icon %> me-1"></i><%= action.label %>
              </button>
            <% } else { %>
              <form action="/admin/orders/<%= order._id %>/<%= action.key === 'approvePayment' ? 'verify-payment' : action.key %>" method="POST" class="order-action-form d-inline" data-confirm="<%= action.confirmMessage %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% if (action.key === 'approvePayment') { %><input type="hidden" name="action" value="approve"><% } %>
                <button type="submit" class="btn <%= action.btnClass %> order-action-btn">
                  <i class="fas <%= action.icon %> me-1"></i><%= action.label %>
                </button>
              </form>
            <% } %>
          <% }) %>
        </div>

        <% const rejectAction = workflow.actions.find(a => a.key === 'rejectPayment'); %>
        <% if (rejectAction) { %>
          <form action="/admin/orders/<%= order._id %>/verify-payment" method="POST" id="rejectPaymentForm" class="mt-3" style="display:none;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="action" value="reject">
            <label class="form-label small fw-bold" for="rejectReason">Rejection Reason <span class="text-danger">*</span></label>
            <textarea name="reason" id="rejectReason" class="form-control mb-2" rows="2" required placeholder="e.g. Transferred amount does not match order total"></textarea>
            <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-times me-1"></i>Confirm Rejection</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="cancelRejectBtn">Cancel</button>
          </form>
        <% } %>
      <% } %>

      <%# Retention info — compact, below the action buttons %>
      <hr class="my-3">
      <p class="mb-0 small text-muted">
        <i class="fas fa-clock-rotate-left me-1"></i>
        <strong>Retention:</strong>
        <% if (order.expiresAt) { %>
          Expires <strong><%= new Date(order.expiresAt).toLocaleDateString('en-PK', { year: 'numeric', month: 'short', day: 'numeric' }) %></strong>
          <span class="text-muted">(auto-deleted by TTL)</span>
        <% } else if (['Delivered','Cancelled'].includes(order.status)) { %>
          <span class="text-muted">Not enrolled — order predates retention feature or auto-delete is off</span>
        <% } else { %>
          <span class="text-muted">—</span>
        <% } %>
      </p>

    </div>
  </div>

  <!-- Customer's Other Orders -->
  <% if (otherOrders.length > 0) { %>
    <div class="col-12">
      <div class="card-box">
        <h5 class="mb-3"><i class="fas fa-history me-2"></i>Other Orders from This Customer</h5>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead class="table-light">
              <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% otherOrders.forEach(o => { %>
                <tr>
                  <td>#<%= o._id.toString().slice(-8).toUpperCase() %></td>
                  <td><%= o.createdAt.toLocaleDateString('en-PK') %></td>
                  <td><%= formatPrice(o.totalAmount) %></td>
                  <td><%= o.status %></td>
                  <td><a href="/admin/orders/<%= o._id %>" class="btn btn-sm btn-outline-primary">View</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>

</div>

<script>
  // Prevent double-submission while the next page loads. Each handler does
  // its own confirm() check and only disables the button if the user
  // actually confirms — a single point of control per form, so a cancelled
  // confirm() can never leave a button stuck in "Processing...".
  function disableSubmitButton(form) {
    var btn = form.querySelector('button[type="submit"]');
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';
    }
  }

  // One generic handler for every business-action button (Ship, Deliver,
  // Cancel, Approve Payment) — each form's confirm wording comes from
  // data-confirm, set server-side from services/orderWorkflowService.js's
  // ACTION_DEFINITIONS, so there's exactly one place that owns that text.
  document.querySelectorAll('.order-action-form').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      var message = form.getAttribute('data-confirm');
      if (message && !confirm(message)) {
        e.preventDefault();
        return;
      }
      disableSubmitButton(form);
    });
  });

  var showRejectFormBtn = document.getElementById('showRejectFormBtn');
  var rejectForm = document.getElementById('rejectPaymentForm');
  var cancelRejectBtn = document.getElementById('cancelRejectBtn');

  if (showRejectFormBtn && rejectForm) {
    showRejectFormBtn.addEventListener('click', function() {
      rejectForm.style.display = 'block';
      showRejectFormBtn.style.display = 'none';
      document.getElementById('rejectReason').focus();
    });
  }

  if (cancelRejectBtn && rejectForm && showRejectFormBtn) {
    cancelRejectBtn.addEventListener('click', function() {
      rejectForm.style.display = 'none';
      showRejectFormBtn.style.display = 'inline-block';
      document.getElementById('rejectReason').value = '';
    });
  }

  if (rejectForm) {
    rejectForm.addEventListener('submit', function(e) {
      var reason = document.getElementById('rejectReason').value.trim();
      if (!reason) {
        e.preventDefault();
        return;
      }
      if (!confirm('Reject this payment? The customer will be asked to resubmit their payment details.')) {
        e.preventDefault();
        return;
      }
      disableSubmitButton(this);
    });
  }
</script>
