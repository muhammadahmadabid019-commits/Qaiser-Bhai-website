<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 style="font-weight: 700; color: #0F2A4A;">Manage Orders</h2>
</div>

<div class="card-box">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th scope="col">Order ID</th>
          <th scope="col">Customer</th>
          <th scope="col">Date</th>
          <th scope="col">Total</th>
          <th scope="col">Payment Method</th>
          <th scope="col">Payment Status</th>
          <th scope="col">Order Status</th>
          <th scope="col" class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders.length === 0) { %>
          <tr>
            <td colspan="8" class="text-center py-4">No orders found yet.</td>
          </tr>
        <% } else { %>
          <% orders.forEach(order => { %>
            <tr>
              <td class="fw-semibold">#<%= order._id.toString().slice(-8).toUpperCase() %></td>
              <td><%= order.customerName %></td>
              <td><%= order.createdAt.toLocaleDateString('en-PK') %></td>
              <td><%= formatPrice(order.totalAmount) %></td>
              <td><%= order.paymentMethod %></td>
              <td>
                <% if (order.paymentStatus === 'Paid') { %>
                  <span class="badge bg-success"><%= order.paymentStatus %></span>
                <% } else if (order.paymentStatus === 'Pending Verification') { %>
                  <span class="badge bg-warning text-dark"><%= order.paymentStatus %></span>
                <% } else if (order.paymentStatus === 'Failed') { %>
                  <span class="badge bg-danger"><%= order.paymentStatus %></span>
                <% } else { %>
                  <span class="badge bg-secondary"><%= order.paymentStatus %></span>
                <% } %>
              </td>
              <td>
                <% if (order.status === 'Delivered') { %>
                  <span class="badge bg-success"><%= order.status %></span>
                <% } else if (order.status === 'Cancelled') { %>
                  <span class="badge bg-danger"><%= order.status %></span>
                <% } else if (order.status === 'Processing' || order.status === 'Shipped') { %>
                  <span class="badge bg-info text-dark"><%= order.status %></span>
                <% } else { %>
                  <span class="badge bg-secondary"><%= order.status %></span>
                <% } %>
              </td>
              <td class="text-end">
                <a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-outline-primary me-1">
                  <i class="fas fa-eye"></i> View
                </a>
                <% if (order.paymentMethod === 'Bank Transfer' && order.paymentStatus === 'Pending Verification') { %>
                  <a href="/admin/orders/<%= order._id %>#payment-verification" class="btn btn-sm btn-outline-warning">
                    <i class="fas fa-file-invoice-dollar"></i> Verify Payment
                  </a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (totalPages > 1) { %>
    <nav class="mt-3">
      <ul class="pagination justify-content-center mb-0">
        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
          <a class="page-link" href="/admin/orders?page=<%= currentPage - 1 %>">Previous</a>
        </li>
        <li class="page-item disabled">
          <span class="page-link">Page <%= currentPage %> of <%= totalPages %></span>
        </li>
        <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="/admin/orders?page=<%= currentPage + 1 %>">Next</a>
        </li>
      </ul>
    </nav>
  <% } %>
</div>
