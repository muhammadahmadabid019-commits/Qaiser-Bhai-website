  <section id="home" class="hero">
    <div class="container">
      <div class="hero-content">
        <p class="hero-tag"><i class="fas fa-network-wired"></i> Infinite Solutions, One Source</p>
        <h1>Powering Your Business with <span class="blue">Smart IT &amp; Networking</span></h1>
        <p class="hero-sub">Complete IT infrastructure, servers, cloud management, and networking solutions tailored to your business.</p>
        <div class="hero-btns">
          <a href="#services" class="btn btn-main"><i class="fas fa-cogs"></i> Explore Services</a>
          <a href="/products" class="btn btn-out"><i class="fas fa-shopping-bag"></i> Shop Now</a>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="section bg-alt fade-in">
    <div class="container">
      <div class="text-center mb-5">
        <span class="tag">What We Do</span>
        <h2>Our Core <span class="blue">Services</span></h2>
        <span class="section-heading-accent"></span>
      </div>

      <% if (!services || services.length === 0) { %>
        <div class="text-center text-muted">Services coming soon. Check back shortly!</div>
      <% } else { %>
        <div class="service-strip">
          <% services.forEach((svc, i) => { %>
            <a href="/services/<%= svc.slug %>" class="svc-cell <%= i % 2 === 0 ? 'line-blue' : 'line-red' %>">
              <div class="svc-icon"><i class="fas <%= svc.icon || 'fa-cogs' %>"></i></div>
              <h4 class="svc-title"><%= svc.name %></h4>
              <p class="svc-text"><%= svc.tagline || svc.description %></p>
              <span class="svc-more">More <i class="fas fa-arrow-right"></i></span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <section id="partners" class="partners fade-in">
    <div class="container">
      <p class="partners-title">Trusted Partners</p>
    </div>
    <div class="partners-marquee" aria-label="Our trusted technology partners">
      <div class="partners-track">
        <%
          const partners = [
            ['Hikvision', 'hikvision'],
            ['Dahua Technology', 'dahua'],
            ['TP-Link', 'tp-link'],
            ['Synology', 'synology'],
            ['Western Digital', 'western-digital'],
            ['Ruijie Networks', 'ruijie'],
            ['UniFi', 'unifi'],
            ['D-Link', 'd-link'],
            ['Molex', 'molex'],
            ['Grandstream', 'grandstream'],
            ['Schneider Electric', 'schneider'],
            ['EZVIZ', 'ezviz-logo'],
            ['Imou', 'imou-logo']
          ];
        %>
        <% for (let rep = 0; rep < 2; rep++) { %>
          <% partners.forEach(([name, file]) => { %>
            <div class="partner-card">
              <img src="/images/partners/<%= file %>.png" alt="<%= name %>"
                   data-partner="<%= file %>"
                   <%= rep === 1 ? 'aria-hidden="true"' : '' %> loading="eager">
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </section>

  <section id="why-choose-us" class="section band-navy fade-in">
    <div class="container">
      <div class="text-center mb-5">
        <span class="tag">Why unieQ</span>
        <h2>Why <span class="blue">Choose Us</span></h2>
        <span class="section-heading-accent"></span>
      </div>
      <div class="row g-4 justify-content-center text-center">
        <div class="col-6 col-lg-3">
          <div class="wcu-item">
            <div class="wcu-icon"><i class="fas fa-shield-halved"></i></div>
            <h5>Reliable Solutions</h5>
            <p>Quality you can trust</p>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="wcu-item">
            <div class="wcu-icon"><i class="fas fa-users"></i></div>
            <h5>Expert Team</h5>
            <p>Experienced professionals</p>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="wcu-item">
            <div class="wcu-icon"><i class="fas fa-sliders"></i></div>
            <h5>Customized Approach</h5>
            <p>Solutions tailored for you</p>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="wcu-item">
            <div class="wcu-icon"><i class="fas fa-headset"></i></div>
            <h5>24/7 Support</h5>
            <p>Always here to help</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="solutions" class="section fade-in our-solutions">
    <div class="container">
      <div class="text-center mb-5">
        <span class="tag">What We Deliver</span>
        <h2>Our <span class="blue">Solutions</span></h2>
        <span class="section-heading-accent"></span>
      </div>
      <div class="row g-4">
        <% const solutionTiles = [
             { label: 'Enterprise Network', img: '/images/solution-enterprise-network.jpg', href: '/services/networking-solutions' },
             { label: 'Data Center',        img: '/images/solution-data-center.jpg',        href: '/services/data-and-server-solutions' },
             { label: 'Security Systems',   img: '/images/solution-security-systems.jpg',   href: '/services/security-solutions' },
             { label: 'Support and Maintenance',  img: '/images/solution-it-infrastructure.jpg',  href: '/services/it-support-and-maintenance' }
           ]; %>
        <% solutionTiles.forEach(tile => { %>
          <div class="col-6 col-lg-3">
            <a href="<%= tile.href %>" class="solution-tile">
              <img src="<%= tile.img %>" alt="<%= tile.label %>" loading="lazy">
              <span class="solution-label"><%= tile.label %></span>
            </a>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section id="testimonials" class="section bg-alt fade-in">
    <div class="container">
      <div class="text-center mb-5">
        <span class="tag">Client Reviews</span>
        <h2>What Our <span class="blue">Clients Say</span></h2>
        <p class="sub">Trusted by hundreds of clients across Pakistan.</p>
      </div>

      <div class="row g-4 mb-5">
        <% if (reviews.length === 0) { %>
          <div class="col-12 text-center" style="color:#5C6F82;">
            No reviews yet. Be the first to share your experience!
          </div>
        <% } else { %>
          <% reviews.forEach(review => { %>
            <div class="col-md-4">
              <div class="review-card">
                <p>"<%= review.message %>"</p>
                <div class="reviewer">
                  <div class="avatar"><%= review.customerName.trim().split(/\s+/).map(w => w[0]).join('').slice(0, 2).toUpperCase() %></div>
                  <div>
                    <strong><%= review.customerName %></strong>
                  </div>
                </div>
                <div class="stars">
                  <% for (let i = 1; i <= 5; i++) { %><%= i <= review.rating ? '★' : '☆' %><% } %>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

      <div class="row justify-content-center">
        <div class="col-lg-7">
          <% if (currentUser && currentUser.id) { %>
            <div class="review-form-card">
              <h5 class="mb-3" style="color:#0B1F3A;">Share Your Experience</h5>
              <form id="reviewForm">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label style="color:#5C6F82;">Your Name</label>
                    <input type="text" id="reviewCustomerName" class="form-control" value="<%= currentUser.name %>" required />
                  </div>
                  <div class="col-md-6">
                    <label style="color:#5C6F82;" class="d-block">Rating</label>
                    <div class="star-rating">
                      <input type="radio" id="rate5" name="rating" value="5" />
                      <label for="rate5" title="5 stars"><i class="fas fa-star"></i></label>
                      <input type="radio" id="rate4" name="rating" value="4" />
                      <label for="rate4" title="4 stars"><i class="fas fa-star"></i></label>
                      <input type="radio" id="rate3" name="rating" value="3" />
                      <label for="rate3" title="3 stars"><i class="fas fa-star"></i></label>
                      <input type="radio" id="rate2" name="rating" value="2" />
                      <label for="rate2" title="2 stars"><i class="fas fa-star"></i></label>
                      <input type="radio" id="rate1" name="rating" value="1" />
                      <label for="rate1" title="1 star"><i class="fas fa-star"></i></label>
                    </div>
                  </div>
                  <div class="col-12">
                    <label style="color:#5C6F82;">Your Review</label>
                    <textarea id="reviewMessage" class="form-control" rows="3" placeholder="Tell us about your experience..." required></textarea>
                  </div>
                  <div class="col-12">
                    <button type="submit" id="reviewSubmitBtn" class="btn btn-main w-100">
                      <i class="fas fa-paper-plane"></i> Submit Review
                    </button>
                  </div>
                  <div class="col-12">
                    <div id="reviewSuccessMsg" class="success-box" style="display:none;"></div>
                    <div id="reviewErrorMsg" class="error-box" style="display:none;"></div>
                  </div>
                </div>
              </form>
            </div>
          <% } else { %>
            <div class="review-form-card text-center">
              <p class="mb-3" style="color:#5C6F82;">Have you worked with us? <a href="/auth/login" style="color:#145DA0;font-weight:600;">Log in</a> to leave a review.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================
