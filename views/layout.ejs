<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= typeof title !=='undefined' ? title : 'unieQ Solutions' %>
  </title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://code.jquery.com" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" type="image/png" href="/images/unieq-logo.png" />
</head>

<body>

  <nav class="navbar navbar-expand-lg fixed-top" id="mainNavbar">
    <div class="container">
      <a class="navbar-brand d-inline-flex align-items-center" href="/">
        <img src="/images/unieq-logo-full-removebg-preview.png" onerror="this.onerror=null;this.src='/images/unieq-logo.png'" alt="unieQ Solutions" class="site-logo" />
      </a>

      <button class="custom-hamburger" id="hamburgerBtn" aria-label="Toggle Menu">
        <span class="hbar"></span>
        <span class="hbar"></span>
        <span class="hbar"></span>
      </button>

      <ul class="custom-nav-links" id="navLinks">
        <li><a class="nav-link" href="/">Home</a></li>
        <li><a class="nav-link" href="/#services">Services</a></li>
        <li><a class="nav-link" href="/products">Products</a></li>
        <li><a class="nav-link" href="/about">About Us</a></li>
        <li><a class="nav-link" href="/contact">Contact</a></li>

        <!-- Dynamic Auth Links -->
        <% if (currentUser && currentUser.id) { %>
          <!-- My Orders removed: WhatsApp orders are handled outside the order DB -->

          <!-- Cart Icon -->
          <li>
            <a class="nav-link position-relative" href="/cart" id="cartIcon">
              <i class="fas fa-shopping-cart"></i>
              <% if (typeof cartCount !=='undefined' && cartCount> 0) { %>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                  style="font-size: 0.65rem;">
                  <%= cartCount %>
                </span>
                <% } %>
            </a>
          </li>

          <% if (currentUser.role && currentUser.role.trim().toLowerCase()==='admin' ) { %>
            <li><a class="nav-link" href="/admin/products"><i
                  class="fas fa-cogs"></i> Admin</a></li>
            <% } %>
              <li>
                <form action="/auth/logout" method="POST" class="m-0 p-0" style="display:inline;">
                  <button type="submit" class="btn-cart"
                    style="border-radius: 50px; padding: 7px 18px; font-size: 0.83rem;">
                    <i class="fas fa-sign-out-alt"></i> Logout
                  </button>
                </form>
              </li>
              <% } else { %>
                <!-- Cart Icon -->
                <li>
                  <a class="nav-link position-relative" href="/cart" id="cartIcon">
                    <i class="fas fa-shopping-cart"></i>
                    <% if (typeof cartCount !=='undefined' && cartCount> 0) { %>
                      <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                        style="font-size: 0.65rem;">
                        <%= cartCount %>
                      </span>
                      <% } %>
                  </a>
                </li>

                <li><a class="nav-link" href="/auth/login"><i class="fas fa-sign-in-alt"></i> Login</a></li>
                <li><a class="btn-cart" href="/auth/register"
                    style="border-radius: 50px; padding: 7px 18px; font-size: 0.83rem; text-decoration:none;"><i
                      class="fas fa-user-plus"></i> Register</a></li>
                <% } %>
      </ul>
    </div>
  </nav>

  <!-- Flash Messages (floating overlay directly below navbar) -->
  <div class="flash-messages-overlay">
    <% if (typeof messages !=='undefined' && messages.success && messages.success.length> 0) { %>
      <div class="container">
        <div class="success-box alert alert-dismissible fade show shadow-lg mb-0" role="alert">
          <div><i class="fas fa-check-circle me-2"></i><%= messages.success[0] %></div>
          <button type="button" class="btn-close ms-3" data-bs-dismiss="alert" aria-label="Close" onclick="this.closest('.container').remove();"></button>
        </div>
      </div>
    <% } %>
    <% if (typeof messages !=='undefined' && messages.error && messages.error.length> 0) { %>
      <div class="container">
        <div class="error-box alert alert-dismissible fade show shadow-lg mb-0" role="alert">
          <div><i class="fas fa-exclamation-triangle me-2"></i><%= messages.error[0] %></div>
          <button type="button" class="btn-close ms-3" data-bs-dismiss="alert" aria-label="Close" onclick="this.closest('.container').remove();"></button>
        </div>
      </div>
    <% } %>
  </div>

  <%- body %>

    <footer class="footer">
      <div class="container">
        <div class="row g-4">

          <div class="col-lg-4">
            <div class="footer-brand d-inline-flex align-items-center"><img src="/images/unieq-logo-full-removebg-preview.png" onerror="this.onerror=null;this.src='/images/unieq-logo.png'" alt="unieQ Solutions" class="footer-logo" /></div>
            <p style="color:#5C6F82; font-size:0.9rem; margin:12px 0 20px;">Pakistan's trusted provider of CCTV,
              networking, server and IT solutions since 2017.</p>
            <div class="socials">
              <a href="#"><i class="fab fa-facebook-f"></i></a>
              <a href="#"><i class="fab fa-instagram"></i></a>
              <a href="#"><i class="fab fa-linkedin-in"></i></a>
              <a href="https://wa.me/<%= whatsappNumber %>" target="_blank" rel="noopener noreferrer"><i
                  class="fab fa-whatsapp"></i></a>
            </div>
          </div>

          <div class="col-lg-2 col-md-6">
            <h6 class="footer-head">Quick Links</h6>
            <ul class="footer-links">
              <li><a href="/">Home</a></li>
              <li><a href="/#services">Services</a></li>
              <li><a href="/products">Products</a></li>
              <li><a href="/about">About Us</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>

          <div class="col-lg-3 col-md-6">
            <h6 class="footer-head">Services</h6>
            <ul class="footer-links">
              <li><a href="/services/networking-solutions">Networking Solutions</a></li>
              <li><a href="/services/data-and-server-solutions">Data &amp; Server Solutions</a></li>
              <li><a href="/services/cloud-solutions">Cloud Solutions</a></li>
              <li><a href="/services/cctv-solutions">CCTV &amp; Surveillance</a></li>
              <li><a href="/services/security-solutions">Security Solutions</a></li>
              <li><a href="/services/electric-fence">Electric Fence</a></li>
              <li><a href="/services/it-support-and-maintenance">Support &amp; Maintenance</a></li>
            </ul>
          </div>

          <div class="col-lg-3">
            <h6 class="footer-head">Contact Info</h6>
            <ul class="footer-contact">
              <li><i class="fas fa-map-marker-alt"></i> Office no 16/MZ-2 Al-Hafeez Shopping Mall, Gulberg3, Lahore</li>
              <li><i class="fas fa-phone"></i> +92-301-899-9603</li>
              <li><i class="fas fa-envelope"></i> theunieqsol@gmail.com</li>
              <li><i class="fas fa-envelope"></i> info@unieqsol.com</li>
              <li><i class="fas fa-clock"></i> Mon–Sat: 9AM – 6PM</li>
            </ul>
          </div>

        </div>

        <div class="footer-bottom">
          <p style="width:100%; text-align:center; margin:0;">&copy; 2017 unieQ Solutions. All Rights Reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/script.js"></script>
</body>

</html>