<h2 style="margin:0 0 16px; font-size:20px; color:#0a1628;">Your Order Has Shipped!</h2>
<p style="margin:0 0 16px; font-size:14px; color:#4a5568; line-height:1.6;">
  Hi <%= order.customerName %>, order #<%= orderNumber %> is on its way to you.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px; font-size:14px; color:#4a5568;">
  <tr>
    <td style="padding:4px 0;"><strong>Order Number:</strong></td>
    <td style="padding:4px 0; text-align:right;">#<%= orderNumber %></td>
  </tr>
  <tr>
    <td style="padding:4px 0;"><strong>Delivery Method:</strong></td>
    <td style="padding:4px 0; text-align:right;"><%= order.deliveryMethod %></td>
  </tr>
  <tr>
    <td style="padding:4px 0;"><strong>Order Status:</strong></td>
    <td style="padding:4px 0; text-align:right; color:#0a66c2; font-weight:600;">Shipped</td>
  </tr>
</table>

<h3 style="margin:0 0 8px; font-size:14px; color:#0a1628;">Shipping To</h3>
<p style="margin:0 0 24px; font-size:14px; color:#4a5568; line-height:1.6;">
  <%= [order.shippingAddress.houseNo, order.shippingAddress.street, order.shippingAddress.area].filter(Boolean).join(', ') %><br>
  <%= [order.shippingAddress.city, order.shippingAddress.province, order.shippingAddress.postalCode].filter(Boolean).join(', ') %>
</p>

<table role="presentation" cellpadding="0" cellspacing="0">
  <tr>
    <td style="border-radius:8px; background-color:#00b4ff;">
      <a href="<%= orderUrl %>" style="display:inline-block; padding:12px 24px; font-size:14px; font-weight:600; color:#051221; text-decoration:none;">Track Your Order</a>
    </td>
  </tr>
</table>
