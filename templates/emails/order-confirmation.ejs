<h2 style="margin:0 0 16px; font-size:20px; color:#0a1628;">Thank you for your order, <%= order.customerName %>!</h2>
<p style="margin:0 0 24px; font-size:14px; color:#4a5568; line-height:1.6;">
  We've received your order and it's now being processed. Here's a summary of what you ordered.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px; font-size:14px; color:#4a5568;">
  <tr>
    <td style="padding:4px 0;"><strong>Order Number:</strong></td>
    <td style="padding:4px 0; text-align:right;">#<%= orderNumber %></td>
  </tr>
  <tr>
    <td style="padding:4px 0;"><strong>Order Date:</strong></td>
    <td style="padding:4px 0; text-align:right;"><%= orderDate %></td>
  </tr>
  <tr>
    <td style="padding:4px 0;"><strong>Payment Method:</strong></td>
    <td style="padding:4px 0; text-align:right;"><%= order.paymentMethod %></td>
  </tr>
  <tr>
    <td style="padding:4px 0;"><strong>Payment Status:</strong></td>
    <td style="padding:4px 0; text-align:right;"><%= order.paymentStatus %></td>
  </tr>
  <tr>
    <td style="padding:4px 0;"><strong>Order Status:</strong></td>
    <td style="padding:4px 0; text-align:right;"><%= order.status %></td>
  </tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; margin-bottom:24px;">
  <thead>
    <tr style="background-color:#f4f7fb;">
      <th align="left" style="padding:10px 12px; font-size:12px; color:#5b6b82; border-bottom:1px solid #e5e9f0;">Product</th>
      <th align="center" style="padding:10px 12px; font-size:12px; color:#5b6b82; border-bottom:1px solid #e5e9f0;">Qty</th>
      <th align="right" style="padding:10px 12px; font-size:12px; color:#5b6b82; border-bottom:1px solid #e5e9f0;">Unit Price</th>
      <th align="right" style="padding:10px 12px; font-size:12px; color:#5b6b82; border-bottom:1px solid #e5e9f0;">Total</th>
    </tr>
  </thead>
  <tbody>
    <% order.items.forEach(function (item) { %>
      <tr>
        <td style="padding:10px 12px; font-size:14px; color:#1a202c; border-bottom:1px solid #f0f2f5;"><%= item.name %></td>
        <td align="center" style="padding:10px 12px; font-size:14px; color:#1a202c; border-bottom:1px solid #f0f2f5;"><%= item.quantity %></td>
        <td align="right" style="padding:10px 12px; font-size:14px; color:#1a202c; border-bottom:1px solid #f0f2f5;"><%= formatPrice(item.price) %></td>
        <td align="right" style="padding:10px 12px; font-size:14px; color:#1a202c; border-bottom:1px solid #f0f2f5;"><%= formatPrice(item.price * item.quantity) %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px; font-size:14px; color:#4a5568;">
  <tr>
    <td style="padding:2px 0;">Subtotal</td>
    <td style="padding:2px 0; text-align:right;"><%= formatPrice(order.subtotal) %></td>
  </tr>
  <tr>
    <td style="padding:2px 0;">Shipping</td>
    <td style="padding:2px 0; text-align:right;"><%= order.deliveryFee === 0 ? 'FREE' : formatPrice(order.deliveryFee) %></td>
  </tr>
  <tr>
    <td style="padding:2px 0;">Tax</td>
    <td style="padding:2px 0; text-align:right;"><%= formatPrice(order.tax) %></td>
  </tr>
  <tr>
    <td style="padding:10px 0 0; font-size:16px; font-weight:700; color:#0a1628; border-top:1px solid #e5e9f0;">Grand Total</td>
    <td style="padding:10px 0 0; font-size:16px; font-weight:700; color:#0a1628; text-align:right; border-top:1px solid #e5e9f0;"><%= formatPrice(order.totalAmount) %></td>
  </tr>
</table>

<h3 style="margin:0 0 8px; font-size:14px; color:#0a1628;">Shipping Address</h3>
<p style="margin:0 0 24px; font-size:14px; color:#4a5568; line-height:1.6;">
  <%= [order.shippingAddress.houseNo, order.shippingAddress.street, order.shippingAddress.area].filter(Boolean).join(', ') %><br>
  <%= [order.shippingAddress.city, order.shippingAddress.province, order.shippingAddress.postalCode].filter(Boolean).join(', ') %><br>
  <%= order.phone %>
</p>

<table role="presentation" cellpadding="0" cellspacing="0">
  <tr>
    <td style="border-radius:8px; background-color:#00b4ff;">
      <a href="<%= orderUrl %>" style="display:inline-block; padding:12px 24px; font-size:14px; font-weight:600; color:#051221; text-decoration:none;">View Your Order</a>
    </td>
  </tr>
</table>
